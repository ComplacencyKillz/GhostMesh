---
interface Props {
  title: string;
  section: string;
  classification?: string;
  description?: string;
  introLines?: string[];   // ominous chapter intro lines shown before content
  introAction?: string;    // button label, default "[ ACCESS ]"
}

const {
  title,
  section,
  classification = 'UNLICENSED / ORIGIN: THE WASTE',
  description = 'Transmitted outside sanctioned channels.',
  introLines = [],
  introAction = '[ ACCESS ]',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
    <title>{title} :: GHOSTMESH</title>
    <style is:global>
      @import '../styles/global.css';
      /* Sub-pages: body must not scroll — scene-panel handles its own overflow */
      body { overflow: hidden; }
    </style>
  </head>
  <body>

    <div class="crt-overlay"   aria-hidden="true"></div>
    <div class="noise-overlay" aria-hidden="true"></div>

    <!-- Video background — muted autoplay on sub-pages -->
    <video id="sub-video" autoplay loop muted playsinline preload="auto"
      style="position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;opacity:0.35;">
      <source src="/video/ghostmesh.mp4" type="video/mp4" />
    </video>

    <!-- Mesh canvas — matches main page texture -->
    <canvas id="mesh-canvas" aria-hidden="true"
      style="position:fixed;inset:0;width:100%;height:100%;z-index:1;opacity:0.45;pointer-events:none;"></canvas>

    <div class="sub-vignette" aria-hidden="true"></div>

    <div class="corner corner--tl" aria-hidden="true"></div>
    <div class="corner corner--tr" aria-hidden="true"></div>
    <div class="corner corner--bl" aria-hidden="true"></div>
    <div class="corner corner--br" aria-hidden="true"></div>

    <!-- Return links below corner bracket -->
    <a href="/" class="sub-return-link" aria-label="Return to GhostMesh menu">← MENU</a>
    <a href="https://complacencykillz.me" class="sub-main-link" aria-label="Return to main menu">← MAIN</a>

    <!-- Top sys bar with REC in it -->
    <div class="sys-bar sys-bar--top">
      <div class="sys-top-ticker-wrap">
        <span class="sys-top-ticker">GHOSTMESH &gt; {section} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      </div>
      <div class="rec" aria-hidden="true"><span class="rec-dot"></span>REC</div>
    </div>

    <!-- Chapter intro popup -->
    {introLines.length > 0 && (
      <div id="chapter-intro">
        <div class="chapter-body">
          <p class="chapter-header">{section}</p>
          {introLines.map((line) => (
            <p class="chapter-line">{line}</p>
          ))}
          <button id="chapter-access">{introAction}</button>
        </div>
      </div>
    )}

    <!-- Scrollable scene panel -->
    <main class="scene-panel" id="scene-panel" style={introLines.length > 0 ? 'visibility:hidden' : ''}>
      <header class="scene-header">
        <p class="scene-classify">{classification}</p>
        <h1 class="scene-title">{title}</h1>
      </header>

      <div class="scene-body">
        <slot />
      </div>
    </main>

    <!-- Bottom sys bar — two scrolling halves -->
    <div class="sys-bar sys-bar--bottom">
      <div class="sys-btm-half sys-btm-left">
        <span class="sys-btm-ticker">ghostmesh.info &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      </div>
      <div class="sys-btm-half sys-btm-right">
        <span class="sys-text" id="ts"></span>
      </div>
    </div>

  </body>
</html>

<style>
  /* ── Video + vignette ───────────────────────────────────────── */
  .sub-vignette {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%,
      rgba(0,0,0,0.55) 0%,
      rgba(0,0,0,0.82) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* ── REC lives inside the top sys-bar ──────────────────────── */
  .rec {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--red);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    font-family: 'JetBrains Mono', monospace;
    flex-shrink: 0;
  }
  .rec-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--red);
    animation: rec-blink 1.8s ease-in-out infinite;
  }
  @keyframes rec-blink { 0%,100%{opacity:1} 50%{opacity:0.08} }

  /* ── Return links — below corner bracket ────────────────────── */
  .sub-return-link,
  .sub-main-link {
    position: fixed;
    right: 2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-decoration: none;
    color: var(--text-dim);
    z-index: 20;
    transition: color 0.15s;
  }
  .sub-return-link { top: 3rem; }
  .sub-main-link   { top: 4.2rem; }
  .sub-return-link:hover,
  .sub-main-link:hover { color: var(--blue); }

  /* ── Chapter intro popup ───────────────────────────────────── */
  #chapter-intro {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    font-family: 'JetBrains Mono', monospace;
  }

  .chapter-body {
    max-width: 460px;
    width: 100%;
    padding: 0 2rem;
  }

  .chapter-header {
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    color: var(--red);
    margin-bottom: 2rem;
  }

  .chapter-line {
    font-size: 0.82rem;
    line-height: 1.9;
    color: var(--text);
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
  }

  #chapter-access {
    display: block;
    margin-top: 2.5rem;
    background: none;
    border: 1px solid var(--text-dim);
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    padding: 0.7rem 1.8rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    animation: chapter-pulse 2s ease-in-out infinite;
  }

  #chapter-access:hover { border-color: var(--blue); color: var(--blue); }

  @keyframes chapter-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0,212,255,0); }
    50%       { box-shadow: 0 0 0 4px rgba(0,212,255,0.08); }
  }

  /* ── Scene panel — scrollable content ──────────────────────── */
  .scene-panel {
    position: fixed;
    top: 2.2rem;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(760px, 100%);
    z-index: 5;
    padding: 2rem 2rem;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
  }

  /* Visible scrollbar */
  .scene-panel::-webkit-scrollbar       { width: 4px; }
  .scene-panel::-webkit-scrollbar-track { background: transparent; }
  .scene-panel::-webkit-scrollbar-thumb { background: var(--text-dim); border-radius: 2px; }

  .scene-header {
    margin-bottom: 2.5rem;
  }

  .scene-classify {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--red);
    margin-bottom: 0.6rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .scene-title {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 900;
    color: var(--blue);
    letter-spacing: 0.12em;
    line-height: 1;
    text-shadow: 0 0 30px rgba(0, 212, 255, 0.25);
    font-family: 'JetBrains Mono', monospace;
  }

  /* ── Scene body typography ──────────────────────────────────── */
  .scene-body h2 {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.2em;
    margin: 2.5rem 0 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--text-ghost);
    font-family: 'JetBrains Mono', monospace;
  }

  .scene-body p {
    font-size: 0.8rem;
    line-height: 1.85;
    color: var(--text);
    margin-bottom: 1rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .scene-body a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--text-ghost);
    transition: border-color 0.15s;
  }
  .scene-body a:hover { border-color: var(--blue); }

  /* ── Data tables ────────────────────────────────────────────── */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.72rem;
    margin: 0.8rem 0 2rem;
    font-family: 'JetBrains Mono', monospace;
  }
  .data-table th {
    text-align: left;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    font-size: 0.62rem;
    border-bottom: 1px solid var(--text-ghost);
    padding: 0.5rem 1rem 0.5rem 0;
  }
  .data-table td {
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--text-ghost);
    color: var(--text);
    vertical-align: top;
  }
  .data-table td:first-child { color: var(--blue); }

  /* ── Code blocks ────────────────────────────────────────────── */
  .code-block {
    background: rgba(0, 3, 18, 0.75);
    border: 1px solid var(--text-ghost);
    border-left: 2px solid var(--blue);
    padding: 1rem 1.2rem;
    font-size: 0.72rem;
    line-height: 1.7;
    margin: 0.8rem 0 1.5rem;
    overflow-x: auto;
    font-family: 'JetBrains Mono', monospace;
  }

  .code-block pre { margin: 0; color: var(--text); }

  /* ── Tags ───────────────────────────────────────────────────── */
  .tag {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--text-ghost);
    color: var(--text-dim);
    margin-right: 0.4rem;
    margin-bottom: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
  }
  .tag--active { border-color: var(--terminal); color: var(--terminal); }
  .tag--warn   { border-color: var(--red);      color: var(--red); }

  /* ── Divider ────────────────────────────────────────────────── */
  .scene-divider {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--text-ghost);
  }

  .scene-divider p {
    font-size: 0.62rem;
    color: var(--text-ghost);
    letter-spacing: 0.15em;
  }

  /* ── Top bar scrolling ticker ──────────────────────────────── */
  .sys-bar--top { padding: 0 1.5rem 0 0; }

  .sys-top-ticker-wrap {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    padding: 0.5rem 0 0.5rem 1.5rem;
  }

  .sys-top-ticker {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    font-family: 'JetBrains Mono', monospace;
    animation: sys-top-tick 22s linear infinite;
  }

  @keyframes sys-top-tick {
    0%   { transform: translateX(110%); }
    100% { transform: translateX(-110%); }
  }

  /* ── Bottom bar two-half tickers ───────────────────────────── */
  .sys-bar--bottom { padding: 0; }

  .sys-btm-half {
    width: 50%;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  .sys-btm-left {
    padding-left: 1.5rem;
    border-right: 1px solid var(--text-ghost);
  }

  .sys-btm-right {
    padding-right: 1.5rem;
    justify-content: flex-end;
  }

  .sys-btm-ticker {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    font-family: 'JetBrains Mono', monospace;
    animation: sys-btm-tick 18s linear infinite;
  }

  @keyframes sys-btm-tick {
    0%   { transform: translateX(110%); }
    100% { transform: translateX(-110%); }
  }
</style>

<script>
  // Mesh canvas — same as main page
  var meshCanvas = document.getElementById('mesh-canvas');
  var meshCtx    = meshCanvas ? meshCanvas.getContext('2d') : null;

  if (meshCanvas && meshCtx) {
    function resizeMesh() {
      meshCanvas.width  = window.innerWidth;
      meshCanvas.height = window.innerHeight;
    }
    resizeMesh();
    window.addEventListener('resize', resizeMesh);

    var NODE_COUNT = 7;
    var nodes = [];
    for (var ni = 0; ni < NODE_COUNT; ni++) {
      nodes.push({
        x:          Math.random() * window.innerWidth,
        y:          Math.random() * window.innerHeight,
        vx:         (Math.random() - 0.5) * 0.2,
        vy:         (Math.random() - 0.5) * 0.2,
        pulse:      Math.random() * Math.PI * 2,
        pulseSpeed: 0.016 + Math.random() * 0.016,
      });
    }

    var signals = [];
    function spawnSignal() {
      var from = Math.floor(Math.random() * NODE_COUNT);
      var to   = Math.floor(Math.random() * NODE_COUNT);
      while (to === from) to = Math.floor(Math.random() * NODE_COUNT);
      signals.push({ from: from, to: to, t: 0, speed: 0.005 + Math.random() * 0.004 });
    }
    setInterval(spawnSignal, 1400);

    function drawMesh() {
      meshCtx.clearRect(0, 0, meshCanvas.width, meshCanvas.height);

      for (var i = 0; i < NODE_COUNT; i++) {
        for (var j = i + 1; j < NODE_COUNT; j++) {
          var dx = nodes[i].x - nodes[j].x, dy = nodes[i].y - nodes[j].y;
          var dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < 260) {
            meshCtx.strokeStyle = 'rgba(0,212,255,' + ((1 - dist / 260) * 0.09) + ')';
            meshCtx.lineWidth = 0.5;
            meshCtx.beginPath();
            meshCtx.moveTo(nodes[i].x, nodes[i].y);
            meshCtx.lineTo(nodes[j].x, nodes[j].y);
            meshCtx.stroke();
          }
        }
      }

      for (var n = 0; n < nodes.length; n++) {
        var nd = nodes[n];
        nd.pulse += nd.pulseSpeed;
        var glow = 0.5 + 0.5 * Math.sin(nd.pulse);
        meshCtx.beginPath();
        meshCtx.arc(nd.x, nd.y, 3 + glow * 3, 0, Math.PI * 2);
        meshCtx.strokeStyle = 'rgba(0,212,255,' + (0.06 + glow * 0.06) + ')';
        meshCtx.lineWidth = 1;
        meshCtx.stroke();
        meshCtx.beginPath();
        meshCtx.arc(nd.x, nd.y, 1.5, 0, Math.PI * 2);
        meshCtx.fillStyle = 'rgba(0,212,255,' + (0.4 + glow * 0.4) + ')';
        meshCtx.fill();
        nd.x += nd.vx; nd.y += nd.vy;
        if (nd.x < 0 || nd.x > meshCanvas.width)  nd.vx *= -1;
        if (nd.y < 0 || nd.y > meshCanvas.height) nd.vy *= -1;
      }

      for (var si = signals.length - 1; si >= 0; si--) {
        var s = signals[si];
        s.t += s.speed;
        if (s.t >= 1) { signals.splice(si, 1); continue; }
        var fn = nodes[s.from], tn = nodes[s.to];
        var sx = fn.x + (tn.x - fn.x) * s.t;
        var sy = fn.y + (tn.y - fn.y) * s.t;
        var ts = Math.max(0, s.t - 0.07);
        meshCtx.beginPath();
        meshCtx.moveTo(fn.x + (tn.x - fn.x) * ts, fn.y + (tn.y - fn.y) * ts);
        meshCtx.lineTo(sx, sy);
        meshCtx.strokeStyle = 'rgba(0,255,65,0.2)';
        meshCtx.lineWidth = 1.5;
        meshCtx.stroke();
        meshCtx.beginPath();
        meshCtx.arc(sx, sy, 2, 0, Math.PI * 2);
        meshCtx.fillStyle = 'rgba(0,255,65,0.85)';
        meshCtx.fill();
      }

      requestAnimationFrame(drawMesh);
    }
    drawMesh();
  }

  // Clock
  var el = document.getElementById('ts');
  function tick() {
    if (el) el.textContent = new Date().toISOString().replace('T',' ').slice(0,19)+' UTC';
  }
  tick();
  setInterval(tick, 1000);

  // Chapter intro dismiss — clicking ACCESS is the audio unlock gesture
  var subVideo  = document.getElementById('sub-video');
  var intro     = document.getElementById('chapter-intro');
  var panel     = document.getElementById('scene-panel');
  var accessBtn = document.getElementById('chapter-access');

  if (intro && accessBtn && panel) {
    accessBtn.addEventListener('click', function() {
      // Unlock audio on this user gesture
      if (subVideo) {
        subVideo.muted  = false;
        subVideo.volume = 0.2;
      }
      intro.style.opacity    = '0';
      intro.style.transition = 'opacity 0.5s';
      setTimeout(function() {
        intro.remove();
        panel.style.visibility = 'visible';
      }, 500);
    });
  } else {
    // No intro on this page — keep video muted
  }
</script>

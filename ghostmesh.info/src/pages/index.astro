---
import Layout from '../layouts/Layout.astro';

const menuItems = [
  { num: '01', label: 'INITIALIZE SYSTEM',  path: '/mission',   sub: 'Transmission origin'     },
  { num: '02', label: 'HARDWARE MANIFEST',  path: '/hardware',  sub: 'Components and assembly' },
  { num: '03', label: 'FIRMWARE',           path: '/software',  sub: 'Build and deploy'        },
  { num: '04', label: 'FIELD OPERATIONS',   path: '/usecases',  sub: 'Operational use cases'   },
  { num: '05', label: 'SYSTEM LOGS',        path: '/docs',      sub: 'Documentation archive'   },
  { num: '06', label: 'ROADMAP',            path: '/roadmap',   sub: 'Signal forward'          },
];
---

<Layout title="GHOSTMESH" description="Transmitted outside sanctioned channels.">

  <!-- Return prompt — shown instead of full splash on repeat visits -->
  <div id="return-prompt" style="display:none;">
    <div class="return-body">
      <p class="return-header">SIGNAL RESTORED</p>
      <p class="return-line">The node held your position.</p>
      <p class="return-line return-gap return-dim">// connection re-established</p>
      <div class="return-actions">
        <button id="return-confirm">[ RESUME TRANSMISSION ]</button>
      </div>
    </div>
  </div>

  <!-- Splash / warning screen -->
  <div id="splash">
    <div class="splash-body">
      <p class="splash-domain">COMPLACENCYKILLZ.ME &gt; SCENE SELECTION</p>
      <p class="splash-title">GHOSTMESH</p>
      <p class="splash-classify">// UNLICENSED TRANSMISSION</p>
    </div>
    <p class="splash-prompt" id="splash-prompt">PRESS ANY KEY TO RECEIVE TRANSMISSION</p>

    <div id="splash-lines">
      <span class="splash-line sl-hidden" id="sl-1">This material has not been reviewed, approved, or sanctioned</span>
      <span class="splash-line sl-hidden" id="sl-2">by any government, corporation, or arcology authority.</span>
      <span class="splash-line sl-hidden sl-gap sl-bright" id="sl-3">It carries no Listener's License.</span>
      <span class="splash-line sl-hidden sl-bright" id="sl-4">No Creativity Permit was filed.</span>
      <span class="splash-line sl-hidden sl-gap" id="sl-5">What you are about to access was designed in the Waste,</span>
      <span class="splash-line sl-hidden" id="sl-6">assembled outside sanctioned channels,</span>
      <span class="splash-line sl-hidden" id="sl-7">and broadcast so that you might at least prepare.</span>
      <button id="splash-ack" aria-label="Acknowledge and enter">[ ACKNOWLEDGE ]</button>
    </div>

    <p class="splash-candles" id="splash-candles">// so light your candles</p>
  </div>

  <!-- Video background -->
  <video id="bg-video" loop muted playsinline preload="auto">
    <source src="/video/ghostmesh.mp4" type="video/mp4" />
  </video>

  <!-- Mesh canvas overlay -->
  <canvas id="mesh-canvas" aria-hidden="true"></canvas>

  <!-- Vignette — darkens edges so menu items are readable -->
  <div class="vignette" aria-hidden="true"></div>

  <div class="corner corner--tl" aria-hidden="true"></div>
  <div class="corner corner--tr" aria-hidden="true"></div>
  <div class="corner corner--bl" aria-hidden="true"></div>
  <div class="corner corner--br" aria-hidden="true"></div>

  <a href="https://complacencykillz.me" class="main-menu-link" aria-label="Return to main menu">← MAIN MENU</a>

  <!-- Ambient data tickers — one per corner, content scrolls -->
  <div class="amb amb-1" aria-hidden="true"><span class="amb-t">// NODE ACTIVE &mdash; GHOSTMESH v0.5 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
  <div class="amb amb-2" aria-hidden="true"><span class="amb-t">MESH: ONLINE &mdash; FREQ: 915MHz / LoRa &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
  <div class="amb amb-3" aria-hidden="true"><span class="amb-t">SIGNAL ████████░░ 82% &mdash; ENC: AES-256 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
  <div class="amb amb-4" aria-hidden="true"><span class="amb-t">ORIGIN: THE WASTE &mdash; LICENSE: NONE &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
  <div class="amb amb-5" aria-hidden="true"><span class="amb-t">CHANNEL: PRIVATE &mdash; TX: 0 BYTES &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
  <div class="amb amb-6" id="liveTime" aria-hidden="true"></div>

  <main class="dvd-menu page">

    <div class="sys-bar sys-bar--top" aria-label="Breadcrumb navigation">
      <span class="sys-text">COMPLACENCYKILLZ.ME &gt; SCENE SELECTION &gt; GHOSTMESH</span>
      <div class="rec" aria-hidden="true"><span class="rec-dot"></span>REC</div>
    </div>

    <!-- Title block — top left, absolutely positioned -->
    <div class="title-block">
      <h1 class="menu-title glitch" id="menuTitle" data-text="GHOSTMESH">GHOSTMESH</h1>
      <p class="menu-tagline" id="menuTagline"></p>
    </div>

    <!-- Menu items — scattered, not centered -->
    {menuItems.map((item, i) => (
      <button
        class={`menu-item menu-item--${i}`}
        aria-label={item.label}
        data-index={i}
        data-path={item.path}
      >
        <span class="item-num">{item.num}</span>
        <span class="item-label">{item.label}</span>
        <span class="item-sub">{item.sub}</span>
      </button>
    ))}

    <div class="sys-bar sys-bar--bottom">
      <div class="sys-btm-half sys-btm-left">
        <span class="sys-btm-ticker">UNLICENSED HARDWARE PROJECT / complacencykillz.me &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
      </div>
      <div class="sys-btm-half sys-btm-right">
        <span class="sys-text" id="timestamp"></span>
      </div>
    </div>

  </main>

  <div class="nav-hint" aria-hidden="true">↑ ↓ NAVIGATE &nbsp;·&nbsp; ENTER ACCESS</div>

</Layout>

<style>
  /* ── Splash ─────────────────────────────────────────────── */
  #splash {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 9992;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
  }

  .splash-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .splash-domain {
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    color: var(--text-ghost);
  }

  .splash-title {
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: 0.12em;
    color: var(--blue);
    line-height: 1;
    text-shadow: 0 0 40px rgba(0, 212, 255, 0.3);
  }

  .splash-classify {
    font-size: 0.55rem;
    letter-spacing: 0.22em;
    color: var(--text-dim);
    border: 1px solid var(--text-ghost);
    padding: 0.3rem 0.8rem;
  }

  .splash-prompt {
    position: absolute;
    bottom: 3.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--blue);
    animation: splash-blink 1.6s ease-in-out infinite;
  }

  @keyframes splash-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.15; }
  }

  #splash-lines {
    display: none;
    flex-direction: column;
    align-items: center;
    margin-top: 2.5rem;
    text-align: center;
  }

  .splash-line {
    display: block;
    font-size: 0.76rem;
    line-height: 1.9;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    min-height: 1.5em;
    font-family: 'JetBrains Mono', monospace;
  }

  .sl-hidden { opacity: 0; }
  .sl-gap    { margin-top: 1rem; }
  .sl-bright { color: var(--text); }

  /* ── Return prompt ──────────────────────────────────────── */
  #return-prompt {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 9992;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
  }

  .return-body {
    max-width: 420px;
    width: 100%;
    padding: 0 2rem;
  }

  .return-header {
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: var(--red);
    margin-bottom: 2rem;
  }

  .return-line {
    font-size: 0.78rem;
    line-height: 1.9;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .return-gap     { margin-top: 1.2rem; }
  .return-dim { color: var(--text-ghost); }

  .return-actions {
    margin-top: 2.5rem;
  }

  .return-actions button {
    background: none;
    border: 1px solid var(--text-dim);
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    padding: 0.7rem 1.8rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    animation: ack-pulse 2s ease-in-out infinite;
  }

  #return-confirm:hover { border-color: var(--blue); color: var(--blue); }

  #splash-ack {
    display: block;
    margin: 2.5rem auto 0;
    background: none;
    border: 1px solid var(--text-dim);
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    padding: 0.8rem 2rem;
    cursor: pointer;
    opacity: 0;
    animation: ack-pulse 2s ease-in-out infinite;
  }

  #splash-ack:hover { border-color: var(--blue); color: var(--blue); }

  @keyframes ack-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0,212,255,0); }
    50%       { box-shadow: 0 0 0 4px rgba(0,212,255,0.08); }
  }

  .splash-candles {
    position: absolute;
    bottom: 2rem;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    color: var(--text-ghost);
    opacity: 0;
  }

  /* ── Video + canvas ─────────────────────────────────────── */
  #bg-video {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
  }

  #mesh-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .vignette {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 35% 45%,
      transparent 25%,
      rgba(0, 0, 0, 0.80) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* ── Chrome ─────────────────────────────────────────────── */
  .corner {
    position: fixed;
    width: 20px;
    height: 20px;
    border-color: rgba(0, 212, 255, 0.2);
    border-style: solid;
    z-index: 10;
  }
  .corner--tl { top: 1.2rem;    left:  1.2rem; border-width: 1px 0 0 1px; }
  .corner--tr { top: 1.2rem;    right: 1.2rem; border-width: 1px 1px 0 0; }
  .corner--bl { bottom: 1.2rem; left:  1.2rem; border-width: 0 0 1px 1px; }
  .corner--br { bottom: 1.2rem; right: 1.2rem; border-width: 0 1px 1px 0; }

  /* REC lives inside the top sys-bar — no fixed positioning needed */
  .rec {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--red);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    font-family: 'JetBrains Mono', monospace;
    flex-shrink: 0;
  }
  .rec-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--red);
    animation: rec-blink 1.8s ease-in-out infinite;
  }
  @keyframes rec-blink { 0%,100%{opacity:1} 50%{opacity:0.08} }

  /* ── Ambient data tickers ───────────────────────────────── */
  .amb {
    position: fixed;
    width: 160px;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: rgba(0, 212, 255, 0.5);
    pointer-events: none;
    z-index: 6;
    font-family: 'JetBrains Mono', monospace;
    opacity: 0;
  }

  /* Scrolling inner span */
  .amb-t {
    display: inline-block;
    animation: amb-ticker 14s linear infinite;
  }
  /* Stagger so corners don't all sync up */
  .amb-2 .amb-t { animation-delay: -3s; }
  .amb-3 .amb-t { animation-delay: -7s; }
  .amb-4 .amb-t { animation-delay: -1.5s; }
  .amb-5 .amb-t { animation-delay: -5s; }

  @keyframes amb-ticker {
    0%   { transform: translateX(160px); }
    100% { transform: translateX(-100%); }
  }

  /* Corner positions — two per side, slight vertical offset */
  .amb-1 { top: 7vh;     left: 4vw; }
  .amb-2 { top: 7vh;     right: 4vw; }
  .amb-3 { top: 11vh;    right: 4vw; color: rgba(0,212,255,0.35); }
  .amb-4 { bottom: 11vh; right: 4vw; }
  .amb-5 { bottom: 7vh;  left: 4vw; }
  .amb-6 {
    bottom: 7vh; right: 4vw;
    width: auto; overflow: visible; white-space: nowrap;
    font-size: 0.5rem; color: rgba(0,212,255,0.4);
  }

  /* ── Layout ─────────────────────────────────────────────── */
  .dvd-menu {
    position: relative;
    min-height: 100vh;
    z-index: 5;
    overflow: hidden;
  }

  /* ── Title block — top-left, large ─────────────────────── */
  .title-block {
    position: absolute;
    top: clamp(60px, 12vh, 140px);
    left: clamp(24px, 5vw, 80px);
    pointer-events: none;
  }

  .menu-title {
    font-size: clamp(3.2rem, 10vw, 8rem);
    font-weight: 900;
    color: var(--text);
    letter-spacing: 0.08em;
    line-height: 0.9;
    opacity: 0;
  }

  .menu-tagline {
    margin-top: 1rem;
    font-size: 0.72rem;
    color: rgba(200, 212, 232, 0.65);
    letter-spacing: 0.14em;
    font-style: italic;
    opacity: 0;
    min-height: 1.2em;
  }

  /* ── Menu items — scattered ─────────────────────────────── */
  .menu-item {
    position: absolute;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 0.5rem 0.8rem;
    opacity: 0;
    outline: none;
    font-family: 'JetBrains Mono', monospace;
    z-index: 8;
  }

  /* Override global.css width:100% — items are absolutely positioned here,
     not in a list. Without this every button stretches across the viewport. */
  .menu-item {
    width: auto;
    display: block;
    padding: 0.5rem 0.8rem;
  }

  /* Dark fog — sized to the button content, no backdrop-filter artifacts */
  .menu-item::before {
    content: '';
    position: absolute;
    inset: -0.6rem -1.2rem;
    background: radial-gradient(ellipse at center,
      rgba(0, 3, 18, 0.80) 20%,
      rgba(0, 3, 18, 0.45) 60%,
      transparent 100%
    );
    border-radius: 10px;
    z-index: -1;
    pointer-events: none;
  }

  .item-num {
    display: block;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: var(--text-ghost);
    margin-bottom: 0.2rem;
    transition: color 0.15s;
  }
  .item-label {
    display: block;
    font-size: clamp(0.7rem, 1.3vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    transition: color 0.15s;
    white-space: nowrap;
  }
  .item-sub {
    display: block;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--text-ghost);
    margin-top: 0.15rem;
    transition: color 0.15s;
  }

  .menu-item.is-selected .item-label {
    color: var(--blue);
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
  }
  .menu-item.is-selected .item-num  { color: var(--text-dim); }
  .menu-item.is-selected .item-sub  { color: var(--text-dim); }
  .menu-item:hover .item-label {
    color: var(--text);
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.9), 0 0 24px rgba(0, 0, 0, 0.7);
  }
  .menu-item:hover .item-sub { color: var(--text-dim); }

  /* Idle cycle highlight — same blue as is-selected */
  .menu-item.is-cycling .item-label {
    color: var(--blue);
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.45);
  }
  .menu-item.is-cycling .item-num { color: var(--text-dim); }
  .menu-item.is-cycling .item-sub { color: var(--text-dim); }

  /* Scattered positions — asymmetric, DVD-style */
  .menu-item--0 { top: 18%;    right: 16vw; }
  .menu-item--1 { top: 36%;    right: 7vw;  }
  .menu-item--2 { top: 56%;    right: 20vw; }
  .menu-item--3 { bottom: 30%; left: 9vw;   }
  .menu-item--4 { bottom: 18%; left: 5vw;   }
  .menu-item--5 { bottom: 12%; right: 11vw; }

  /* ── Main menu return — sits below corner bracket ──────── */
  .main-menu-link {
    position: fixed;
    top: 3rem;
    right: 2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--text-dim);
    text-decoration: none;
    z-index: 20;
    transition: color 0.15s;
  }
  .main-menu-link:hover { color: var(--blue); }

  /* ── Sys bars ───────────────────────────────────────────── */
  .sys-bar {
    position: fixed;
    left: 0; right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 2rem;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    border-color: var(--text-ghost);
    z-index: 10;
    font-family: 'JetBrains Mono', monospace;
  }
  .sys-bar--top    { top: 0;    border-bottom: 1px solid var(--text-ghost); }
  .sys-bar--bottom { bottom: 0; border-top:    1px solid var(--text-ghost); }

  .sys-text { color: var(--text-dim); font-size: 0.65rem; letter-spacing: 0.15em; }

  /* ── Bottom bar two-half tickers ───────────────────────── */
  .sys-bar--bottom { padding: 0; }

  .sys-btm-half {
    width: 50%;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  .sys-btm-left {
    padding-left: 1.5rem;
    border-right: 1px solid var(--text-ghost);
  }

  .sys-btm-right {
    padding-right: 1.5rem;
    justify-content: flex-end;
  }

  .sys-btm-ticker {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    font-family: 'JetBrains Mono', monospace;
    animation: sys-btm-tick 22s linear infinite;
  }

  @keyframes sys-btm-tick {
    0%   { transform: translateX(110%); }
    100% { transform: translateX(-110%); }
  }

  .return-link {
    color: var(--text-dim);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-decoration: none;
    border-bottom: 1px solid var(--text-ghost);
    padding-bottom: 2px;
    transition: color 0.15s, border-color 0.15s;
  }
  .return-link:hover { color: var(--blue); border-color: var(--blue); }

  /* ── Nav hint ───────────────────────────────────────────── */
  .nav-hint {
    position: fixed;
    bottom: 2.8rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    color: var(--text-ghost);
    z-index: 10;
    opacity: 0;
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  /* ── Mobile layout ───────────────────────────────────────── */
  @media (max-width: 700px) {

    .title-block {
      position: relative;
      top: auto; left: auto;
      text-align: center;
      width: 100%;
      padding-top: 4.5rem;
      margin-bottom: 1.5rem;
      pointer-events: none;
    }

    .menu-title  { font-size: clamp(2.8rem, 14vw, 5rem); }
    .menu-tagline { font-size: 0.62rem; }

    .dvd-menu {
      position: fixed;
      top: 2.2rem;
      bottom: 2.2rem;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      min-height: unset;
      padding-bottom: 2rem;
    }

    .menu-item {
      position: relative !important;
      top: auto !important; right: auto !important;
      left: auto !important; bottom: auto !important;
      width: 88%;
      max-width: 360px;
      border-bottom: 1px solid var(--text-ghost);
      padding: 0.75rem 0.5rem;
    }

    .menu-item::before { display: none; }

    .amb   { width: 120px; font-size: 0.48rem; }
    .amb-3 { display: none; }
    .amb-4 { bottom: 4.5rem; }
    .amb-6 { bottom: 2.8rem; right: 3vw; }

    .sys-bar--top .sys-text:first-child { display: none; }
    .nav-hint { display: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  /* ── Mesh canvas overlay ──────────────────────────────────── */
  var meshCanvas = document.getElementById('mesh-canvas');
  var meshCtx    = meshCanvas ? meshCanvas.getContext('2d') : null;

  function resizeMesh() {
    if (!meshCanvas) return;
    meshCanvas.width  = window.innerWidth;
    meshCanvas.height = window.innerHeight;
  }

  if (meshCanvas && meshCtx) {
    resizeMesh();
    window.addEventListener('resize', resizeMesh);

    var NODE_COUNT = 7;
    var nodes = [];
    for (var ni = 0; ni < NODE_COUNT; ni++) {
      nodes.push({
        x:          Math.random() * window.innerWidth,
        y:          Math.random() * window.innerHeight,
        vx:         (Math.random() - 0.5) * 0.2,
        vy:         (Math.random() - 0.5) * 0.2,
        pulse:      Math.random() * Math.PI * 2,
        pulseSpeed: 0.016 + Math.random() * 0.016,
      });
    }

    var signals = [];

    function spawnSignal() {
      var from = Math.floor(Math.random() * NODE_COUNT);
      var to   = Math.floor(Math.random() * NODE_COUNT);
      while (to === from) to = Math.floor(Math.random() * NODE_COUNT);
      signals.push({ from: from, to: to, t: 0, speed: 0.005 + Math.random() * 0.004 });
    }

    setInterval(spawnSignal, 1400);

    function drawMesh() {
      if (!meshCtx || !meshCanvas) return;
      meshCtx.clearRect(0, 0, meshCanvas.width, meshCanvas.height);

      for (var i = 0; i < NODE_COUNT; i++) {
        for (var j = i + 1; j < NODE_COUNT; j++) {
          var dx   = nodes[i].x - nodes[j].x;
          var dy   = nodes[i].y - nodes[j].y;
          var dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < 260) {
            meshCtx.strokeStyle = 'rgba(0,212,255,' + ((1 - dist / 260) * 0.09) + ')';
            meshCtx.lineWidth   = 0.5;
            meshCtx.beginPath();
            meshCtx.moveTo(nodes[i].x, nodes[i].y);
            meshCtx.lineTo(nodes[j].x, nodes[j].y);
            meshCtx.stroke();
          }
        }
      }

      for (var n = 0; n < nodes.length; n++) {
        var nd = nodes[n];
        nd.pulse += nd.pulseSpeed;
        var glow = 0.5 + 0.5 * Math.sin(nd.pulse);
        meshCtx.beginPath();
        meshCtx.arc(nd.x, nd.y, 3 + glow * 3, 0, Math.PI * 2);
        meshCtx.strokeStyle = 'rgba(0,212,255,' + (0.06 + glow * 0.06) + ')';
        meshCtx.lineWidth   = 1;
        meshCtx.stroke();
        meshCtx.beginPath();
        meshCtx.arc(nd.x, nd.y, 1.5, 0, Math.PI * 2);
        meshCtx.fillStyle = 'rgba(0,212,255,' + (0.4 + glow * 0.4) + ')';
        meshCtx.fill();
        nd.x += nd.vx; nd.y += nd.vy;
        if (nd.x < 0 || nd.x > meshCanvas.width)  nd.vx *= -1;
        if (nd.y < 0 || nd.y > meshCanvas.height) nd.vy *= -1;
      }

      for (var si = signals.length - 1; si >= 0; si--) {
        var s = signals[si];
        s.t += s.speed;
        if (s.t >= 1) { signals.splice(si, 1); continue; }
        var fn = nodes[s.from], tn = nodes[s.to];
        var sx = fn.x + (tn.x - fn.x) * s.t;
        var sy = fn.y + (tn.y - fn.y) * s.t;
        var ts = Math.max(0, s.t - 0.07);
        meshCtx.beginPath();
        meshCtx.moveTo(fn.x + (tn.x - fn.x) * ts, fn.y + (tn.y - fn.y) * ts);
        meshCtx.lineTo(sx, sy);
        meshCtx.strokeStyle = 'rgba(0,255,65,0.2)';
        meshCtx.lineWidth   = 1.5;
        meshCtx.stroke();
        meshCtx.beginPath();
        meshCtx.arc(sx, sy, 2, 0, Math.PI * 2);
        meshCtx.fillStyle = 'rgba(0,255,65,0.85)';
        meshCtx.fill();
      }

      requestAnimationFrame(drawMesh);
    }

    drawMesh();
  }

  /* ── Typewriter ───────────────────────────────────────────── */
  function typewrite(el, text, speed) {
    return new Promise(function(resolve) {
      var i = 0;
      el.textContent = '';
      var iv = setInterval(function() {
        el.textContent += text[i++];
        if (i >= text.length) { clearInterval(iv); resolve(); }
      }, speed || 18);
    });
  }

  function wait(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }

  /* ── Navigation ───────────────────────────────────────────── */
  var items = document.querySelectorAll('.menu-item');
  var cur   = 0;

  function select(i) {
    if (items[cur]) items[cur].classList.remove('is-selected');
    cur = Math.max(0, Math.min(i, items.length - 1));
    if (items[cur]) items[cur].classList.add('is-selected');
  }

  function go() {
    var p = items[cur] && items[cur].dataset.path;
    if (p) window.location.href = p;
  }

  document.addEventListener('keydown', function(e) {
    if (dismissed && !transmissionStarted) return;
    if (e.key === 'ArrowDown')  { e.preventDefault(); select(cur + 1); }
    if (e.key === 'ArrowUp')    { e.preventDefault(); select(cur - 1); }
    if (e.key === 'Enter' && dismissed) { go(); }
  });

  items.forEach(function(item, i) {
    item.addEventListener('click',      function() { select(i); go(); });
    item.addEventListener('mouseenter', function() { select(i); });
  });

  /* ── Entrance animation ───────────────────────────────────── */
  var isMobile = window.innerWidth <= 700;

  function runEntrance() {
    if (meshCanvas) gsap.to(meshCanvas, { opacity: 0.45, duration: 1.5, ease: 'power2.inOut' });

    if (isMobile) {
      // Mobile: items are in flex column — simple stagger fade, no offsets
      gsap.set('.menu-item--0,.menu-item--1,.menu-item--2,.menu-item--3,.menu-item--4,.menu-item--5',
               { opacity: 0 });
      gsap.timeline({ defaults: { ease: 'power2.out' } })
        .to('.amb-1', { opacity: 1, duration: 0.3 })
        .to('.amb-2', { opacity: 1, duration: 0.3 }, '-=0.15')
        .add(function() {
          var titleEl = document.getElementById('menuTitle');
          if (titleEl) gsap.to(titleEl, { opacity: 1, duration: 0.3 });
          var tagEl = document.getElementById('menuTagline');
          if (tagEl) gsap.to(tagEl, { opacity: 1, duration: 0.3, delay: 0.3, onStart: function() {
            typewrite(tagEl, 'My weapons are my skills.', 22);
          }});
        }, '-=0.1')
        .to('.menu-item--0,.menu-item--1,.menu-item--2,.menu-item--3,.menu-item--4,.menu-item--5',
            { opacity: 1, duration: 0.35, stagger: 0.08 }, '+=0.1')
        .to('.amb-5', { opacity: 1, duration: 0.3 }, '-=0.1')
        .add(function() { select(0); startIdleCycle(); });
    } else {
      // Desktop: directional slide-in matching the scattered positions
      gsap.set('.menu-item--0', { y: -14, opacity: 0 });
      gsap.set('.menu-item--1', { x:  18, opacity: 0 });
      gsap.set('.menu-item--2', { x:  14, opacity: 0 });
      gsap.set('.menu-item--3', { y:  14, opacity: 0 });
      gsap.set('.menu-item--4', { x: -14, opacity: 0 });
      gsap.set('.menu-item--5', { y:  12, opacity: 0 });

      gsap.timeline({ defaults: { ease: 'power2.out' } })
        .to('.amb-1', { opacity: 1, duration: 0.3 })
        .to('.amb-2', { opacity: 1, duration: 0.3 }, '-=0.15')
        .to('.amb-3', { opacity: 1, duration: 0.3 }, '-=0.15')
        .add(function() {
          var titleEl = document.getElementById('menuTitle');
          if (titleEl) gsap.to(titleEl, { opacity: 1, duration: 0.3 });
          var tagEl = document.getElementById('menuTagline');
          if (tagEl) gsap.to(tagEl, { opacity: 1, duration: 0.2, delay: 0.3, onStart: function() {
            typewrite(tagEl, 'My weapons are my skills.', 22);
          }});
        }, '-=0.1')
        .to('.menu-item--0', { opacity: 1, y: 0, duration: 0.25 }, '+=0.15')
        .to('.menu-item--1', { opacity: 1, x: 0, duration: 0.25 }, '-=0.15')
        .to('.menu-item--2', { opacity: 1, x: 0, duration: 0.25 }, '-=0.15')
        .to('.menu-item--3', { opacity: 1, y: 0, duration: 0.25 }, '-=0.15')
        .to('.menu-item--4', { opacity: 1, x: 0, duration: 0.25 }, '-=0.15')
        .to('.menu-item--5', { opacity: 1, y: 0, duration: 0.25 }, '-=0.15')
        .to('.amb-4',        { opacity: 1, duration: 0.3 }, '-=0.1')
        .to('.amb-5',        { opacity: 1, duration: 0.3 }, '-=0.2')
        .to('.nav-hint',     { opacity: 1, duration: 0.3 }, '-=0.2')
        .add(function() { select(0); startIdleCycle(); });
    }
  }

  /* ── Splash two-stage logic ───────────────────────────────── */
  var video               = document.getElementById('bg-video');
  var splash              = document.getElementById('splash');
  var returnPrompt        = document.getElementById('return-prompt');
  var transmissionStarted = false;
  var dismissed           = false;

  // Show return prompt if the user navigated here from within the site
  // (referrer includes the same hostname). Works on first visit, private mode,
  // and new tabs without needing sessionStorage state.
  var isReturn = document.referrer.length > 0 &&
                 document.referrer.includes(window.location.hostname);

  var LINES = [
    ['sl-1', 'This material has not been reviewed, approved, or sanctioned'],
    ['sl-2', 'by any government, corporation, or arcology authority.'],
    ['sl-3', "It carries no Listener's License."],
    ['sl-4', 'No Creativity Permit was filed.'],
    ['sl-5', 'What you are about to access was designed in the Waste,'],
    ['sl-6', 'assembled outside sanctioned channels,'],
    ['sl-7', 'and broadcast so that you might at least prepare.'],
  ];

  async function startTransmission() {
    if (transmissionStarted) return;
    transmissionStarted = true;

    // First interaction = browser audio unlock
    if (video) {
      video.muted  = false;
      video.volume = 0.35;
      video.play();
      gsap.to(video, { opacity: 1, duration: 1.5, ease: 'power2.inOut' });
    }
    if (meshCanvas) gsap.to(meshCanvas, { opacity: 0.45, duration: 2, delay: 0.5 });

    // Swap prompt for warning text
    var prompt = document.getElementById('splash-prompt');
    var lines  = document.getElementById('splash-lines');
    if (prompt) {
      gsap.to(prompt, { opacity: 0, duration: 0.3, onComplete: function() {
        if (prompt) prompt.style.display = 'none';
        if (lines)  lines.style.display  = 'flex';
      }});
    }

    await wait(200);

    for (var li = 0; li < LINES.length; li++) {
      var pair = LINES[li];
      var el   = document.getElementById(pair[0]);
      if (el) {
        el.style.opacity = '1';
        await typewrite(el, pair[1], 6);
        await wait(pair[0] === 'sl-4' ? 180 : 40);
      }
    }

    await wait(200);
    gsap.to('#splash-ack',     { opacity: 1, duration: 0.3 });
    gsap.to('#splash-candles', { opacity: 1, duration: 0.5, delay: 0.2 });
  }

  function dismissSplash() {
    if (dismissed) return;
    dismissed = true;
    if (splash) {
      gsap.to(splash, {
        opacity: 0,
        duration: 0.8,
        ease: 'power2.in',
        onComplete: function() { if (splash) splash.remove(); },
      });
    }
    runEntrance();
  }

  // Track whether we restored from bfcache (Back button)
  var fromBfcache = false;

  // CONFIRM button — always wired, handles both link-return and bfcache-return
  var confirmBtn = document.getElementById('return-confirm');
  if (confirmBtn) {
    confirmBtn.addEventListener('click', function() {
      // Audio unlock gesture
      if (video) { video.muted = false; video.volume = 0.35; video.play(); }
      // Hide prompt (keep in DOM so bfcache can show it again)
      gsap.to(returnPrompt, { opacity: 0, duration: 0.5, onComplete: function() {
        if (returnPrompt) { returnPrompt.style.display = 'none'; returnPrompt.style.opacity = '1'; }
      }});
      gsap.to(video,     { opacity: 1,   duration: 1.0, ease: 'power2.inOut' });
      if (meshCanvas) gsap.to(meshCanvas, { opacity: 0.45, duration: 2, delay: 0.4 });
      // Only run entrance if we came via a link (bfcache already has the menu rendered)
      if (!fromBfcache) {
        runEntrance();
      } else {
        select(0);
        startIdleCycle();
      }
    });
  }

  // PAGESHOW — fires on Back button (bfcache restore) even when JS doesn't re-run
  window.addEventListener('pageshow', function(e) {
    if (!e.persisted) return;
    fromBfcache = true;
    // Restart paused video
    if (video) video.play().catch(function() {});
    // Show the return prompt over the restored page
    if (returnPrompt) { returnPrompt.style.display = 'flex'; returnPrompt.style.opacity = '1'; }
  });

  if (isReturn) {
    // ── Came from within site via link ─────────────────────────
    if (splash)       splash.style.display       = 'none';
    if (returnPrompt) returnPrompt.style.display = 'flex';

  } else {
    // ── First visit or direct navigation: full splash ──────────
    function onFirstInteract(e) {
      if (e.type === 'keydown' && ['F5','F12','F11'].includes(e.key)) return;
      document.removeEventListener('keydown', onFirstInteract);
      document.removeEventListener('click',   onFirstInteract);
      startTransmission();
    }

    document.addEventListener('keydown', onFirstInteract);
    document.addEventListener('click',   onFirstInteract);

    var ackBtn = document.getElementById('splash-ack');
    if (ackBtn) ackBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      dismissSplash();
    });
  }

  /* ── Idle cycle ───────────────────────────────────────────── */
  // Fisher-Yates shuffle — guarantees every index appears exactly once per permutation
  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }

  function startIdleCycle() {
    var indices = [0, 1, 2, 3, 4, 5];
    var order   = [];
    var pos     = 0;

    function tick() {
      // Clear previous cycle highlight
      items.forEach(function(item) { item.classList.remove('is-cycling'); });

      // Exhausted the permutation — generate a fresh one
      if (pos >= order.length) {
        order = shuffle(indices);
        pos   = 0;
      }

      var idx = order[pos++];
      if (items[idx]) items[idx].classList.add('is-cycling');

      setTimeout(tick, 1750);
    }

    tick();
  }

  /* ── Clock ────────────────────────────────────────────────── */
  var tsEl   = document.getElementById('timestamp');
  var liveEl = document.getElementById('liveTime');
  function tick() {
    var s = new Date().toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
    if (tsEl)   tsEl.textContent   = s;
    if (liveEl) liveEl.textContent = s;
  }
  tick();
  setInterval(tick, 1000);
</script>

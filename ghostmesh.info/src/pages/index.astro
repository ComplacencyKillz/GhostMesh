---
import Layout from '../layouts/Layout.astro';

const menuItems = [
  { num: '01', label: 'INITIALIZE SYSTEM',  path: '/mission',   sub: 'Transmission origin'       },
  { num: '02', label: 'HARDWARE MANIFEST',  path: '/hardware',  sub: 'Components and assembly'   },
  { num: '03', label: 'FIRMWARE',           path: '/software',  sub: 'Build and deploy'          },
  { num: '04', label: 'FIELD OPERATIONS',   path: '/usecases',  sub: 'Operational use cases'     },
  { num: '05', label: 'SYSTEM LOGS',        path: '/docs',      sub: 'Documentation archive'     },
  { num: '06', label: 'ROADMAP',            path: '/roadmap',   sub: 'Signal forward'            },
];
---

<Layout title="GHOSTMESH" description="Transmitted outside sanctioned channels.">

  <!-- Splash / warning screen -->
  <div id="splash" role="dialog" aria-modal="true" aria-label="Transmission warning">
    <div class="splash-warning">
      <p class="splash-header">⚠ UNLICENSED TRANSMISSION</p>

      <!-- Interaction gate — visible before any key/click -->
      <p class="splash-prompt" id="splash-prompt">// PRESS ANY KEY TO RECEIVE TRANSMISSION</p>

      <!-- Warning lines — hidden until first interaction unlocks them -->
      <div id="splash-lines" style="display:none;">
        <span class="splash-line sl-hidden" id="sl-1">This material has not been reviewed, approved, or sanctioned</span>
        <span class="splash-line sl-hidden" id="sl-2">by any government, corporation, or arcology authority.</span>
        <span class="splash-line sl-hidden sl-gap sl-bright" id="sl-3">It carries no Listener's License.</span>
        <span class="splash-line sl-hidden sl-bright" id="sl-4">No Creativity Permit was filed.</span>
        <span class="splash-line sl-hidden sl-gap" id="sl-5">What you are about to access was designed in the Waste,</span>
        <span class="splash-line sl-hidden" id="sl-6">assembled outside sanctioned channels,</span>
        <span class="splash-line sl-hidden" id="sl-7">and broadcast so that you might at least prepare.</span>
      </div>

      <button id="splash-ack" aria-label="Acknowledge and enter">[ ACKNOWLEDGE ]</button>
    </div>
    <p class="splash-candles" id="splash-candles">// so light your candles</p>
  </div>

  <!-- Video background (muted until ACKNOWLEDGE) -->
  <video id="bg-video" loop muted playsinline preload="auto"
    style="position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;opacity:0;">
    <source src="/video/ghostmesh.mp4" type="video/mp4" />
  </video>

  <!-- Mesh network canvas (on top of video, fades to partial opacity) -->
  <canvas id="mesh-canvas" aria-hidden="true" style="position:fixed;inset:0;z-index:1;opacity:0;"></canvas>

  <div class="corner corner--tl" aria-hidden="true"></div>
  <div class="corner corner--tr" aria-hidden="true"></div>
  <div class="corner corner--bl" aria-hidden="true"></div>
  <div class="corner corner--br" aria-hidden="true"></div>

  <div class="amb amb-1">// NODE ACTIVE<br>GHOSTMESH v0.5</div>
  <div class="amb amb-2">MESH: ONLINE<br>FREQ: 915MHz / LoRa</div>
  <div class="amb amb-3">CHANNEL: PRIVATE<br>ENCRYPTION: AES-256</div>
  <div class="amb amb-4">ORIGIN: THE WASTE<br>LICENSE: NONE</div>

  <main class="dvd-menu page" style="display:flex;flex-direction:column;justify-content:center;min-height:100vh;padding:0 10vw;max-width:900px;margin:0 auto;">

    <div class="sys-bar sys-bar--top" aria-label="Breadcrumb navigation">
      <span class="sys-text">COMPLACENCYKILLZ.ME &gt; SCENE SELECTION &gt; GHOSTMESH</span>
      <a href="https://complacencykillz.me" class="return-link" aria-label="Return to main menu">← MAIN MENU</a>
    </div>

    <div style="margin-bottom:2.5rem;opacity:0;" id="title-block">
      <h1 class="glitch" data-text="GHOSTMESH" style="font-size:clamp(2rem,6vw,3.5rem);color:var(--blue);letter-spacing:0.15em;">GHOSTMESH</h1>
      <p style="font-size:0.7rem;letter-spacing:0.2em;color:var(--text-dim);margin-top:0.5rem;" id="tagline"></p>
    </div>

    <nav aria-label="GhostMesh sections">
      {menuItems.map((item, i) => (
        <button
          class={`menu-item menu-item--${i}`}
          aria-label={item.label}
          data-index={i}
          data-path={item.path}
        >
          <span class="item-num">{item.num}</span>
          <span class="item-label">{item.label}</span>
          <span class="item-sub">{item.sub}</span>
        </button>
      ))}
    </nav>

    <div class="sys-bar sys-bar--bottom">
      <span class="sys-text">UNLICENSED HARDWARE PROJECT / complacencykillz.me</span>
      <span class="sys-text" id="timestamp"></span>
    </div>

  </main>

  <div class="nav-hint" aria-hidden="true">↑ ↓ NAVIGATE &nbsp;·&nbsp; ENTER ACCESS</div>

</Layout>

<style>
  .sl-hidden { opacity: 0; }
  .sl-gap    { margin-top: 1.2rem; display: block; }
  .sl-bright { color: var(--text); }

  .splash-prompt {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    color: var(--blue);
    margin-top: 2rem;
    animation: prompt-blink 1.4s ease-in-out infinite;
  }

  @keyframes prompt-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }
</style>

<script>
  import gsap from 'gsap';

  /* ── Mesh canvas ──────────────────────────────────────────── */
  var canvas = document.getElementById('mesh-canvas');
  var ctx    = canvas ? canvas.getContext('2d') : null;

  function resizeMesh() {
    if (!canvas) return;
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  if (canvas && ctx) {
    resizeMesh();
    window.addEventListener('resize', resizeMesh);

    var NODE_COUNT = 14;
    var nodes = [];
    for (var ni = 0; ni < NODE_COUNT; ni++) {
      nodes.push({
        x:          Math.random() * window.innerWidth,
        y:          Math.random() * window.innerHeight,
        vx:         (Math.random() - 0.5) * 0.25,
        vy:         (Math.random() - 0.5) * 0.25,
        pulse:      Math.random() * Math.PI * 2,
        pulseSpeed: 0.018 + Math.random() * 0.018,
      });
    }

    var signals = [];
    var MAX_DIST = 280;

    function spawnSignal() {
      var from = Math.floor(Math.random() * NODE_COUNT);
      var to   = Math.floor(Math.random() * NODE_COUNT);
      while (to === from) to = Math.floor(Math.random() * NODE_COUNT);
      signals.push({ from: from, to: to, t: 0, speed: 0.006 + Math.random() * 0.005 });
    }

    setInterval(spawnSignal, 1200);

    function drawMesh() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (var i = 0; i < NODE_COUNT; i++) {
        for (var j = i + 1; j < NODE_COUNT; j++) {
          var dx   = nodes[i].x - nodes[j].x;
          var dy   = nodes[i].y - nodes[j].y;
          var dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < MAX_DIST) {
            var a = (1 - dist / MAX_DIST) * 0.12;
            ctx.strokeStyle = 'rgba(0,212,255,' + a + ')';
            ctx.lineWidth   = 0.5;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }

      for (var n = 0; n < nodes.length; n++) {
        var nd = nodes[n];
        nd.pulse += nd.pulseSpeed;
        var glow = 0.5 + 0.5 * Math.sin(nd.pulse);
        ctx.beginPath();
        ctx.arc(nd.x, nd.y, 4 + glow * 4, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(0,212,255,' + (0.08 + glow * 0.07) + ')';
        ctx.lineWidth   = 1;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(nd.x, nd.y, 2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,212,255,' + (0.55 + glow * 0.45) + ')';
        ctx.fill();
        nd.x += nd.vx;
        nd.y += nd.vy;
        if (nd.x < 0 || nd.x > canvas.width)  nd.vx *= -1;
        if (nd.y < 0 || nd.y > canvas.height) nd.vy *= -1;
      }

      for (var si = signals.length - 1; si >= 0; si--) {
        var s = signals[si];
        s.t += s.speed;
        if (s.t >= 1) { signals.splice(si, 1); continue; }
        var fn = nodes[s.from], tn = nodes[s.to];
        var sx = fn.x + (tn.x - fn.x) * s.t;
        var sy = fn.y + (tn.y - fn.y) * s.t;
        var ts = Math.max(0, s.t - 0.07);
        ctx.beginPath();
        ctx.moveTo(fn.x + (tn.x - fn.x) * ts, fn.y + (tn.y - fn.y) * ts);
        ctx.lineTo(sx, sy);
        ctx.strokeStyle = 'rgba(0,255,65,0.25)';
        ctx.lineWidth   = 1.5;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(sx, sy, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,255,65,0.9)';
        ctx.fill();
      }

      requestAnimationFrame(drawMesh);
    }

    drawMesh();
  }

  /* ── Typewriter ───────────────────────────────────────────── */
  function typewrite(el, text, speed) {
    return new Promise(function(resolve) {
      var i = 0;
      el.textContent = '';
      var iv = setInterval(function() {
        el.textContent += text[i++];
        if (i >= text.length) { clearInterval(iv); resolve(); }
      }, speed || 18);
    });
  }

  function wait(ms) {
    return new Promise(function(r) { setTimeout(r, ms); });
  }

  /* ── Video ────────────────────────────────────────────────── */
  var video = document.getElementById('bg-video');

  /* ── Splash sequence ──────────────────────────────────────── */
  var LINES = [
    ['sl-1', 'This material has not been reviewed, approved, or sanctioned'],
    ['sl-2', 'by any government, corporation, or arcology authority.'],
    ['sl-3', "It carries no Listener's License."],
    ['sl-4', 'No Creativity Permit was filed.'],
    ['sl-5', 'What you are about to access was designed in the Waste,'],
    ['sl-6', 'assembled outside sanctioned channels,'],
    ['sl-7', 'and broadcast so that you might at least prepare.'],
  ];

  var transmissionStarted = false;

  async function startTransmission() {
    if (transmissionStarted) return;
    transmissionStarted = true;

    // This click/keypress IS the browser audio unlock gesture
    if (video) {
      video.muted  = false;
      video.volume = 0.35;
      video.play();
      gsap.to(video, { opacity: 1, duration: 1.5, ease: 'power2.inOut' });
    }

    // Swap prompt for lines
    var prompt = document.getElementById('splash-prompt');
    var lines  = document.getElementById('splash-lines');
    if (prompt) gsap.to(prompt, { opacity: 0, duration: 0.3, onComplete: function() {
      if (prompt) prompt.style.display = 'none';
      if (lines)  lines.style.display  = 'block';
    }});

    await wait(400);

    for (var li = 0; li < LINES.length; li++) {
      var pair = LINES[li];
      var el = document.getElementById(pair[0]);
      if (el) {
        el.style.opacity = '1';
        await typewrite(el, pair[1], 16);
        await wait(pair[0] === 'sl-4' ? 500 : 100);
      }
    }

    await wait(500);
    gsap.to('#splash-ack',     { opacity: 1, duration: 0.5 });
    gsap.to('#splash-candles', { opacity: 1, duration: 1, delay: 0.4 });
  }

  // First interaction gate: any key or click starts the transmission
  function onFirstInteract(e) {
    if (e.type === 'keydown' && ['F5','F12','F11'].includes(e.key)) return;
    document.removeEventListener('keydown', onFirstInteract);
    document.removeEventListener('click',   onFirstInteract);
    startTransmission();
  }

  document.addEventListener('keydown', onFirstInteract);
  document.addEventListener('click',   onFirstInteract);

  /* ── Menu entrance ────────────────────────────────────────── */
  function runEntrance() {
    // Set initial positions BEFORE building the timeline
    gsap.set('.menu-item--0', { x: 16, opacity: 0 });
    gsap.set('.menu-item--1', { x: 16, opacity: 0 });
    gsap.set('.menu-item--2', { x: 16, opacity: 0 });
    gsap.set('.menu-item--3', { x: 16, opacity: 0 });
    gsap.set('.menu-item--4', { x: 16, opacity: 0 });
    gsap.set('.menu-item--5', { x: 16, opacity: 0 });

    if (canvas) gsap.to(canvas, { opacity: 0.6, duration: 1.5, ease: 'power2.inOut' });

    gsap.timeline({ defaults: { ease: 'power2.out' } })
      .to('.amb-1', { opacity: 1, duration: 0.5, delay: 0.3 })
      .to('.amb-2', { opacity: 1, duration: 0.5 }, '-=0.2')
      .to('.amb-3', { opacity: 1, duration: 0.5 }, '-=0.3')
      .to('.amb-4', { opacity: 1, duration: 0.5 }, '-=0.3')
      .to('#title-block', { opacity: 1, duration: 0.4 }, '-=0.2')
      .add(function() {
        var el = document.getElementById('tagline');
        if (el) typewrite(el, 'My strength is my knowledge. My weapons are my skills.', 28);
      }, '-=0.1')
      .to('.menu-item--0', { opacity: 1, x: 0, duration: 0.3 }, '+=0.3')
      .to('.menu-item--1', { opacity: 1, x: 0, duration: 0.3 }, '-=0.15')
      .to('.menu-item--2', { opacity: 1, x: 0, duration: 0.3 }, '-=0.15')
      .to('.menu-item--3', { opacity: 1, x: 0, duration: 0.3 }, '-=0.15')
      .to('.menu-item--4', { opacity: 1, x: 0, duration: 0.3 }, '-=0.15')
      .to('.menu-item--5', { opacity: 1, x: 0, duration: 0.3 }, '-=0.15')
      .to('.nav-hint',     { opacity: 1, duration: 0.4 }, '-=0.1');
  }

  /* ── Navigation ───────────────────────────────────────────── */
  var items = document.querySelectorAll('.menu-item');
  var cur   = 0;

  function select(i) {
    if (items[cur]) items[cur].classList.remove('is-selected');
    cur = Math.max(0, Math.min(i, items.length - 1));
    if (items[cur]) items[cur].classList.add('is-selected');
  }

  function go() {
    var p = items[cur] && items[cur].dataset.path;
    if (p) window.location.href = p;
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown')  { e.preventDefault(); select(cur + 1); }
    if (e.key === 'ArrowUp')    { e.preventDefault(); select(cur - 1); }
    if (e.key === 'Enter')      { go(); }
  });

  items.forEach(function(item, i) {
    item.addEventListener('click',      function() { select(i); go(); });
    item.addEventListener('mouseenter', function() { select(i); });
  });

  /* ── Acknowledge ──────────────────────────────────────────── */
  var splash    = document.getElementById('splash');
  var dismissed = false;

  function dismiss() {
    if (dismissed) return;
    dismissed = true;
    gsap.to(splash, {
      opacity: 0,
      duration: 0.7,
      ease: 'power2.in',
      onComplete: function() {
        if (splash) splash.remove();
        select(0);
      },
    });
    runEntrance();
  }

  var ackBtn = document.getElementById('splash-ack');
  if (ackBtn) ackBtn.addEventListener('click', dismiss);

  /* ── Clock ────────────────────────────────────────────────── */
  var tsEl = document.getElementById('timestamp');
  function tick() {
    if (tsEl) tsEl.textContent = new Date().toISOString().replace('T',' ').slice(0,19) + ' UTC';
  }
  tick();
  setInterval(tick, 1000);
</script>

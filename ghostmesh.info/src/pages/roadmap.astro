---
import SubLayout from '../layouts/SubLayout.astro';

const phases = [
  { num:'00', label:'Documentation & Hardware Validation', status:'complete', note:'Wiring confirmed, end-to-end test passed'           },
  { num:'01', label:'UART Byte-Counter FAP',               status:'complete', note:'Compilable FAP, UART open, byte counters'           },
  { num:'02', label:'Canned Message Selector',             status:'complete', note:'Scrollable menu, send, feedback banner'             },
  { num:'03', label:'Field Profiles',                      status:'complete', note:'3 built-ins, SD card YAML loader'                  },
  { num:'04', label:'Node Logging + KML Export',           status:'complete', note:'CSV log, RSSI/SNR, RX history, marquee scroll'      },
  { num:'05', label:'PROTO Mode Full Client',              status:'complete', note:'Hand-coded protobuf, handshake, TX + RX confirmed'  },
  { num:'06', label:'Security Baseline',                   status:'next',     note:'Nuke button, private channel keygen, stealth mode'  },
  { num:'07', label:'Environmental Telemetry',             status:'planned',  note:'BME280 temp/humidity/pressure, RF ducting indicator'},
  { num:'08', label:'GPS + Wardriving',                    status:'planned',  note:'BN-220 GPS, position logging, KML heatmap'          },
  { num:'09', label:'Battery Intelligence',                status:'planned',  note:'MAX17048 fuel gauge, persistent % in UI'            },
  { num:'10', label:'Physical Controls & Alerting',        status:'planned',  note:'Tamper sensors, dead-drop arm/disarm'               },
  { num:'11', label:'Dead-Drop Surveillance',              status:'planned',  note:'HC-SR04 proximity, autonomous alerts'               },
  { num:'12', label:'SIGINT & Advanced Sensing',           status:'planned',  note:'Jammer detection, advanced wardriving'              },
  { num:'13', label:'Remote Payload Execution',            status:'planned',  note:'BadUSB over mesh, NFC orchestration, Sub-GHz relay' },
  { num:'14', label:'UART Encryption',                     status:'planned',  note:'ChaCha20-Poly1305, key management'                 },
];

const style: Record<string, string> = {
  complete: 'color:var(--terminal)',
  next:     'color:var(--blue)',
  planned:  'color:var(--text-dim)',
};

const label: Record<string, string> = {
  complete: 'DONE',
  next:     'NEXT',
  planned:  '...',
};
---

<SubLayout title="ROADMAP" section="ROADMAP"
  classification="CLASSIFICATION: DEVELOPMENT SIGNAL / CURRENT: v0.5"
  introLines={[
    "What has been built.",
    "What will be built.",
    "The signal continues.",
  ]}
  introAction="[ VIEW SIGNAL ]">

  <h2>PHASE INDEX</h2>
  <table class="data-table">
    <thead>
      <tr><th style="width:2.5rem;">PH</th><th>PHASE</th><th style="width:4rem;">STATUS</th><th>SIGNAL</th></tr>
    </thead>
    <tbody>
      {phases.map(p => (
        <tr>
          <td style="color:var(--text-ghost);font-size:0.62rem;">{p.num}</td>
          <td>{p.label}</td>
          <td style={style[p.status]}>{label[p.status]}</td>
          <td style="color:var(--text-dim);font-size:0.68rem;">{p.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>CURRENT STATE — v0.5</h2>
  <p>GhostMesh is a working mesh radio terminal. It sends and receives text
  messages over Meshtastic LoRa mesh using the full PROTO protocol. Received
  messages are logged to SD card with RSSI and SNR. Confirmed end-to-end:
  Flipper → remote node → back to Flipper.</p>

  <h2>NEXT — Phase 6</h2>
  <p>Nuke button, private channel key generation from Flipper hardware RNG,
  and stealth mode (node goes dark — ROUTER role, no GPS, no telemetry,
  OLED off). Software only, no new hardware required.</p>

  <h2>THE BACKPACK GOAL</h2>
  <p>Phases 10–11 complete the autonomous dead-drop backpack: a Heltec node
  left unattended, monitoring an area with multiple sensors, broadcasting
  alerts over LoRa, wiping itself if compromised. No Flipper required at
  the drop site.</p>

  <div class="scene-divider">
    <p>Full phase detail →
      <a href="https://github.com/ComplacencyKillz/GhostMesh/blob/main/docs/roadmap.md"
         target="_blank" rel="noopener">docs/roadmap.md</a>
    </p>
  </div>

</SubLayout>

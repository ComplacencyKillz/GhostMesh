---
import SubLayout from '../layouts/SubLayout.astro';

const phases = [
  { num:'00', label:'Documentation & Hardware Validation', status:'complete', note:'Wiring confirmed, end-to-end test passed'           },
  { num:'01', label:'UART Byte-Counter FAP',               status:'complete', note:'Compilable FAP, UART open, byte counters'           },
  { num:'02', label:'Canned Message Selector',             status:'complete', note:'Scrollable menu, send, feedback banner'             },
  { num:'03', label:'Field Profiles',                      status:'complete', note:'3 built-ins, SD card YAML loader'                  },
  { num:'04', label:'Node Logging + KML Export',           status:'complete', note:'CSV log, RSSI/SNR, RX history, marquee scroll'      },
  { num:'05', label:'PROTO Mode Full Client',              status:'complete', note:'Hand-coded protobuf, handshake, TX + RX confirmed'  },
  { num:'06', label:'Security Baseline',                   status:'next',     note:'Nuke button, private channel keygen, stealth mode'  },
  { num:'07', label:'Environmental Telemetry',             status:'complete', note:'BME280 temp/humidity/pressure on the Sensors screen'},
  { num:'08', label:'GPS + Wardriving',                    status:'complete', note:'BN-220 GPS, position logging (wardriving heatmap pending)'},
  { num:'09', label:'Battery Intelligence',                status:'complete', note:'battery % in the title bar (MAX17048 fuel-gauge read deferred)'},
  { num:'10', label:'Physical Controls & Alerting',        status:'complete', note:'tamper, arming, buzzer/vibration/RGB LED, IR, wipe + the config/silent layer'},
  { num:'11', label:'Dead-Drop Surveillance',              status:'complete', note:'RCWL-1601 proximity, autonomous alerts'             },
  { num:'12', label:'SIGINT & Advanced Sensing',           status:'planned',  note:'Jammer detection, advanced wardriving'              },
  { num:'13', label:'Remote Payload Execution',            status:'planned',  note:'BadUSB over mesh, NFC orchestration, Sub-GHz relay' },
  { num:'14', label:'UART Encryption',                     status:'planned',  note:'ChaCha20-Poly1305, key management'                 },
];

const style: Record<string, string> = {
  complete: 'color:var(--terminal)',
  next:     'color:var(--blue)',
  planned:  'color:var(--text-dim)',
};

const label: Record<string, string> = {
  complete: 'DONE',
  next:     'NEXT',
  planned:  '...',
};
---

<SubLayout title="ROADMAP" section="ROADMAP"
  classification="CLASSIFICATION: DEVELOPMENT SIGNAL / CURRENT: v0.8"
  introLines={[
    "What has been built.",
    "What will be built.",
    "The signal continues.",
  ]}
  introAction="[ VIEW SIGNAL ]">

  <h2>PHASE INDEX</h2>
  <table class="data-table">
    <thead>
      <tr><th style="width:2.5rem;">PH</th><th>PHASE</th><th style="width:4rem;">STATUS</th><th>SIGNAL</th></tr>
    </thead>
    <tbody>
      {phases.map(p => (
        <tr>
          <td style="color:var(--text-ghost);font-size:0.62rem;">{p.num}</td>
          <td>{p.label}</td>
          <td style={style[p.status]}>{label[p.status]}</td>
          <td style="color:var(--text-dim);font-size:0.68rem;">{p.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>CURRENT STATE — v0.8</h2>
  <p>GhostMesh is a working mesh radio terminal <em>and</em> a configurable dead-drop
  backpack. It sends and receives text over the Meshtastic LoRa mesh (full PROTO
  protocol, logged to SD with RSSI/SNR), reads environmental + GPS telemetry, and
  runs the custom backpack: tamper (tilt/light/proximity), arming, IR control, and
  the buzzer/vibration/RGB-LED indicators. Config is live over three surfaces — the
  web configurator, the FAP Settings screen, and the mesh CLI: per-command mesh-reply
  gates, a <strong>silent</strong> stealth mode (screen + LEDs + sound off), per-sensor
  battery gating, GPS/telemetry rate control, browser firmware flashing, and
  <code>/put</code> file upload to a node.</p>

  <h2>NEXT — Phase 6</h2>
  <p>Nuke button and private channel key generation from Flipper hardware RNG. Stealth
  is largely here already — per-element output silencing, GPS/telemetry control, and a
  <code>silent</code> master all ship in the config layer; Phase 6 folds them into a
  single one-press Stealth toggle that also flips the node to ROUTER role. Software
  only, no new hardware required.</p>

  <h2>THE BACKPACK GOAL</h2>
  <p>Phases 10–11 complete the autonomous dead-drop backpack: a Heltec node
  left unattended, monitoring an area with multiple sensors, broadcasting
  alerts over LoRa, wiping itself if compromised. No Flipper required at
  the drop site.</p>

  <div class="scene-divider">
    <p>Full phase detail →
      <a href="https://github.com/ComplacencyKillz/GhostMesh/blob/main/docs/roadmap.md"
         target="_blank" rel="noopener">docs/roadmap.md</a>
    </p>
  </div>

</SubLayout>

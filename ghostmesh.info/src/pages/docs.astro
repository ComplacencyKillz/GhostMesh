---
import SubLayout from '../layouts/SubLayout.astro';

const REPO = 'https://github.com/ComplacencyKillz/GhostMesh/blob/main/';

const docs = [
  { label: 'USER GUIDE',         path: 'docs/user-guide.md',          sub: 'Screen-by-screen walkthrough'        },
  { label: 'DEVELOPER GUIDE',    path: 'docs/developer-guide.md',     sub: 'Architecture and contribution guide' },
  { label: 'HARDWARE REFERENCE', path: 'docs/hardware.md',            sub: 'Full BOM, GPIO allocation'           },
  { label: 'WIRING GUIDE',       path: 'docs/wiring.md',              sub: 'Pinout, connections, sensor wiring'  },
  { label: 'COMMAND CLI',        path: 'docs/command-cli.md',         sub: 'Mesh commands, /set /cfg, /put, configurator' },
  { label: 'MESHTASTIC SETUP',   path: 'docs/meshtastic-setup.md',    sub: 'Node config, channels, sensors'      },
  { label: 'FLIPPER SETUP',      path: 'docs/flipper-setup.md',       sub: 'ufbt build, deploy, troubleshoot'    },
  { label: 'OPSEC GUIDE',        path: 'docs/opsec.md',               sub: 'Encryption, stealth, nuke protocol'  },
  { label: 'SERIAL PROTOCOL',    path: 'docs/serial-modes.md',        sub: 'PROTO field numbers'                 },
  { label: 'ROADMAP',            path: 'docs/roadmap.md',             sub: 'Phases 0–14, current status'         },
  { label: 'PROTO NOTES',        path: 'flipper-app/helpers/proto_notes.md', sub: 'Internal protocol reference'  },
];
---

<SubLayout title="SYSTEM LOGS" section="SYSTEM LOGS"
  classification="CLASSIFICATION: DOCUMENTATION ARCHIVE / REPOSITORY: GITHUB"
  introLines={[
    "Everything transmitted.",
    "Everything received.",
    "Nothing was lost.",
  ]}
  introAction="[ OPEN ARCHIVE ]">

  <h2>DOCUMENT INDEX</h2>
  <table class="data-table">
    <thead><tr><th>FILE</th><th>CONTENTS</th></tr></thead>
    <tbody>
      {docs.map(d => (
        <tr>
          <td>
            <a href={`${REPO}${d.path}`} target="_blank" rel="noopener">{d.label}</a>
          </td>
          <td style="color:var(--text-dim);">{d.sub}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>REPOSITORY</h2>
  <div class="code-block"><pre>github.com/ComplacencyKillz/GhostMesh

License:  MIT
Status:   Active development
Current:  v0.8 — env telemetry + GPS + config layer</pre></div>

  <h2>LOG FORMAT</h2>
  <p>Every received message is logged to the Flipper SD card:</p>
  <div class="code-block"><pre>SD:/apps_data/ghostmesh/log_YYYYMMDD.csv

Columns: timestamp, node_id, message, lat, lon, rssi, snr

2026-05-07T09:15:44,f69c,CHECKIN OK,40.7128,-74.0060,-85,7.5
2026-05-07T09:22:11,2f74,IN POSITION,,,-92,4.2</pre></div>

  <h2>KML EXPORT</h2>
  <div class="code-block"><pre>python tools/log_to_kml.py log_20260507.csv
# → log_20260507.kml  (Google Earth / QGIS)</pre></div>

</SubLayout>

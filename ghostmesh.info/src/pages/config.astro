---
import SubLayout from '../layouts/SubLayout.astro';
---

<SubLayout title="CONFIGURATOR" section="CONFIG"
  classification="CLASSIFICATION: FIELD CONFIG / TRANSPORT: WEB SERIAL / USB"
  introLines={[
    "Connect the node.",
    "Set how it behaves.",
    "Nothing leaves the wire.",
  ]}
  introAction="[ ESTABLISH LINK ]">

  <p>A direct interface to a backpack, over USB. No app. No install. The browser speaks to the node
  the way the Meshtastic client does — <strong>Web Serial</strong>, nothing between you and the wire.
  Every command is addressed to the node itself. Nothing is broadcast. What you set here stays on
  the cable.</p>

  <div id="gm-unsupported" class="gm-note gm-note--warn" style="display:none;">
    INTERFACE UNAVAILABLE. This browser has no Web Serial. Use <strong>Chrome</strong> or
    <strong>Edge</strong> on desktop — you are already on https, the transport is here, the browser
    is not.
  </div>

  <div id="gm-connect-row">
    <button id="gm-connect" class="gm-btn">[ ESTABLISH LINK ]</button>
    <span id="gm-status" class="gm-status">NO SIGNAL</span>
  </div>

  <div id="gm-panel" style="display:none;">
    <h2>SENSING</h2>
    <div class="gm-field">
      <label>Proximity trip</label>
      <div class="gm-ctl">
        <input type="range" id="gm-prox" min="20" max="400" step="5" />
        <output id="gm-prox-out">— cm</output>
      </div>
    </div>
    <div class="gm-field">
      <label>Light threshold</label>
      <div class="gm-ctl">
        <input type="range" id="gm-light" min="0" max="4095" step="50" />
        <output id="gm-light-out">—</output>
      </div>
    </div>

    <h2>MESH REPLIES <span class="tag">GO QUIET</span></h2>
    <p style="margin-top:0.3rem; font-size:0.8rem; color:var(--text-dim); line-height:1.5;">
      What the node announces on the channel. Physical feedback (LED/buzzer/vibration) is separate,
      below — turn these off to stop the chatter and let the hardware be the signal.
    </p>
    <div id="gm-rep"></div>

    <div class="gm-sechead">
      <h2>OUTPUTS <span class="tag">GO DARK</span></h2>
      <button id="gm-silent" class="gm-btn gm-btn--ghost">[ SILENT ]</button>
    </div>
    <p style="margin-top:0.3rem; font-size:0.8rem; color:var(--text-dim); line-height:1.5;">
      The node's physical indicators. <strong>SILENT</strong> kills them all at once — screen dark,
      no LED blinks, no sound. (GPS LED is best-effort.)
    </p>
    <div id="gm-out"></div>

    <div class="gm-sechead">
      <h2>SENSOR INPUTS <span class="tag">BATTERY</span></h2>
      <button id="gm-sensors" class="gm-btn gm-btn--ghost">[ SENSORS OFF ]</button>
    </div>
    <p style="margin-top:0.3rem; font-size:0.8rem; color:var(--text-dim); line-height:1.5;">
      Turn a sensor off to stop it polling and save battery.
    </p>
    <div id="gm-in"></div>

    <h2>GPS &amp; TELEMETRY <span class="tag">BATTERY</span></h2>
    <div class="gm-field gm-field--row">
      <label>GPS</label>
      <button class="gm-toggle" id="gm-gps" data-on="0">OFF</button>
    </div>
    <div class="gm-field">
      <label>GPS update interval</label>
      <div class="gm-ctl">
        <input type="range" id="gm-gpsint" min="0" max="3600" step="30" />
        <output id="gm-gpsint-out">— s</output>
      </div>
    </div>
    <div class="gm-field">
      <label>Telemetry interval</label>
      <div class="gm-ctl">
        <input type="range" id="gm-telint" min="0" max="3600" step="30" />
        <output id="gm-telint-out">— s</output>
      </div>
    </div>

    <div class="scene-divider">
      <button id="gm-refresh" class="gm-btn gm-btn--ghost">[ QUERY NODE ]</button>
    </div>

    <!-- PAYLOAD UPLOAD SECTION (/put protocol) -->
    <div class="scene-divider" style="margin:1.8rem 0 1rem;"></div>
    <h2>PAYLOAD UPLOAD <span class="tag">/put</span></h2>
    <p style="margin-top:0.5rem; font-size:0.85rem; color:var(--text-dim); line-height:1.5;">
      Push a file to the node's storage. It is base64-chunked over the same PROTO channel this page
      already speaks, reassembled on the node, and <strong>CRC32-verified</strong> — missing chunks
      are re-sent automatically. Lands in <code style="color:var(--blue);">/ghostmesh/</code> on the
      node. Over USB this is fast and reliable; the same transfer works over the mesh, slower. Ceiling
      is the node's free flash (a few hundred KB). See
      <a href="https://github.com/ComplacencyKillz/GhostMesh/blob/main/docs/command-cli.md"
         target="_blank" rel="noopener" style="color:var(--terminal);">command-cli.md</a>.
    </p>
    <div id="gm-uploader"></div>
  </div>

  <!-- FIRMWARE FLASH — always available; it owns its own port (does NOT need ESTABLISH LINK) -->
  <div class="scene-divider" style="margin:1.8rem 0 1rem;"></div>
  <h2>FIRMWARE <span class="tag">FLASH</span></h2>
  <p style="margin-top:0.5rem; font-size:0.85rem; color:var(--text-dim); line-height:1.5;">
    Reflash the Heltec ESP32-S3 — the latest GhostMesh build, or your own <code style="color:var(--blue);">.bin</code>.
    This takes over the USB port to reach the ROM bootloader, so it works even if the node isn't
    talking (you don't need to <strong>ESTABLISH LINK</strong> first) — pick the device again when the
    browser asks. Flashes at <code style="color:var(--blue);">0x0</code> without erasing, so channel
    keys and config survive. Chrome/Edge, USB only.
  </p>
  <div id="gm-flasher"></div>

  <h2>TRACE</h2>
  <div class="gm-log" id="gm-log"><span class="gm-dim">No link. Standing by.</span></div>

  <div class="scene-divider">
    <p>Rather work from the terminal? The same node, over the mesh CLI or serial →
      <a href="https://github.com/ComplacencyKillz/GhostMesh/blob/main/docs/command-cli.md"
         target="_blank" rel="noopener">docs/command-cli.md</a>
    </p>
  </div>

</SubLayout>

<style is:global>
  /* is:global on purpose — the toggle rows, flasher and uploader controls are injected
     by JS (innerHTML), so Astro's scoped styles never reach them. All selectors are
     gm-/pu-/fl- prefixed so nothing leaks into the rest of the site. */

  .gm-note { border:1px solid var(--blue); padding:0.8rem 1rem; margin:1rem 0;
    font-size:0.85rem; line-height:1.5; }
  .gm-note--warn { border-color:#c96; color:#eca; }
  #gm-connect-row { display:flex; align-items:center; gap:1rem; margin:1.4rem 0; flex-wrap:wrap; }

  /* ── Buttons: one system across the whole configurator ────── */
  .gm-btn {
    display:inline-block; background:transparent;
    border:1px solid var(--text-dim); color:var(--text);
    font-family:inherit; font-size:0.72rem; letter-spacing:0.2em; text-transform:uppercase;
    padding:0.6rem 1.3rem; cursor:pointer;
    transition:border-color .15s, color .15s, background .15s, box-shadow .15s, transform .05s; }
  .gm-btn:hover { border-color:var(--blue); color:var(--blue); box-shadow:0 0 0 3px rgba(0,212,255,0.06); }
  .gm-btn:active { transform:translateY(1px); }

  /* Primary CTA — establish link */
  #gm-connect { border-color:var(--terminal); color:var(--terminal); }
  #gm-connect:hover { background:var(--terminal); color:#04120a; border-color:var(--terminal);
    box-shadow:0 0 16px rgba(0,255,65,0.35); }

  /* Secondary / master actions (SILENT, SENSORS OFF, QUERY NODE) */
  .gm-btn--ghost { font-size:0.64rem; padding:0.45rem 0.95rem;
    color:var(--text-dim); border-color:var(--text-ghost); }
  .gm-btn--ghost:hover { border-color:var(--blue); color:var(--blue); }

  .gm-status { font-size:0.72rem; color:var(--text-dim); letter-spacing:0.2em; text-transform:uppercase; }
  .gm-status.on { color:var(--terminal); text-shadow:0 0 8px rgba(0,255,65,0.5); }

  /* ── Section header carrying a master action on the right ─── */
  .gm-sechead { display:flex; align-items:flex-end; justify-content:space-between;
    gap:1rem; flex-wrap:wrap; }
  .gm-sechead h2 { flex:1 1 auto; min-width:180px; }
  .gm-sechead .gm-btn { flex:0 0 auto; margin-bottom:0.5rem; }

  /* ── Fields ───────────────────────────────────────────────── */
  .gm-field { margin:0.9rem 0; }
  .gm-field > label { display:block; font-size:0.7rem; color:var(--text-dim);
    letter-spacing:0.15em; text-transform:uppercase; margin-bottom:0.4rem; }
  .gm-ctl { display:flex; align-items:center; gap:0.9rem; max-width:440px; }
  .gm-ctl input[type=range] { flex:1; accent-color:var(--terminal); }
  .gm-ctl output { min-width:66px; color:var(--blue); font-size:0.85rem; text-align:right;
    letter-spacing:0.03em; }

  /* Toggle rows read as a ruled control panel: label left, switch right */
  .gm-field--row { display:flex; align-items:center; justify-content:space-between; gap:1rem;
    max-width:440px; margin:0; padding:0.6rem 0.1rem; border-bottom:1px solid var(--text-ghost); }
  .gm-field--row:first-child { border-top:1px solid var(--text-ghost); }
  .gm-field--row > label { margin:0; font-size:0.72rem; color:var(--text);
    letter-spacing:0.06em; text-transform:none; }

  /* ── Toggle: unmistakable two-state switch with a status LED ─ */
  .gm-toggle { display:inline-flex; align-items:center; justify-content:center; gap:0.55rem;
    min-width:84px; background:transparent; border:1px solid var(--text-ghost); color:var(--text-dim);
    font-family:inherit; font-size:0.7rem; letter-spacing:0.18em; padding:0.4rem 0.9rem; cursor:pointer;
    transition:border-color .15s, color .15s, background .15s, box-shadow .15s; }
  .gm-toggle::before { content:''; width:7px; height:7px; border-radius:50%;
    background:var(--text-ghost); transition:inherit; }
  .gm-toggle:hover { border-color:var(--blue); color:var(--blue); }
  .gm-toggle:hover::before { background:var(--blue); }
  .gm-toggle[data-on="1"] { border-color:var(--terminal); color:var(--terminal);
    background:rgba(0,255,65,0.08); text-shadow:0 0 6px rgba(0,255,65,0.35); }
  .gm-toggle[data-on="1"]::before { background:var(--terminal); box-shadow:0 0 8px rgba(0,255,65,0.85); }

  /* ── Trace log ────────────────────────────────────────────── */
  .gm-log { background:rgba(0,0,0,0.5); border:1px solid rgba(120,160,140,0.25);
    padding:0.7rem 0.9rem; font-size:0.78rem; line-height:1.6; height:150px; overflow-y:auto;
    white-space:pre-wrap; word-break:break-word; }
  .gm-log .gm-dim { color:var(--text-dim); }
  .gm-log .gm-tx { color:var(--blue); }
  .gm-log .gm-rx { color:var(--terminal); }
  .gm-log .gm-err { color:#e88; }

  #gm-flasher, #gm-uploader { margin:1rem 0; }
</style>

<script is:inline type="module">
  // ── GhostMesh Web Serial configurator ──────────────────────────────────────
  // Speaks the minimal Meshtastic StreamAPI our FAP uses: 0x94 0xC3 [len_hi][len_lo][protobuf].
  // want_config → learn our node num → send self-addressed /cfg and /set text commands.
  // is:inline so the browser does native ESM resolution of the /lib/*.js modules
  // (served from public/) instead of Astro trying to bundle a page-inline script.

  // Import component modules
  import { flasherInit } from '/lib/firmware-flasher.js';
  import { putUploaderInit } from '/lib/payload-uploader.js';

  const NONCE = 42;

  // /cfg bitmask layout — array index == bit index. Single source of truth for decode + wiring.
  // Each entry: [/set key, display label]. Must match the firmware's doCfg() bit order.
  const REP_BITS = [['rep_arm', 'Arm/disarm'], ['rep_buzz', 'Buzz'], ['rep_vib', 'Vibrate'],
    ['rep_led', 'LED/FX'], ['rep_wipe', 'Wipe'], ['bc_tilt', 'Tamper: tilt'],
    ['bc_light', 'Tamper: light'], ['bc_prox', 'Person detected']];
  const OUT_BITS = [['led', 'Status LED'], ['buzz', 'Buzzer'], ['vib', 'Vibration'],
    ['screen', 'Screen'], ['hbled', 'Onboard LED'], ['gpsled', 'GPS LED']];
  const IN_BITS = [['in_tilt', 'Tilt'], ['in_light', 'Light'], ['in_prox', 'Proximity'], ['in_ir', 'IR']];

  // ── protobuf helpers ──
  const enc = new TextEncoder();
  const tag = (f, w) => (f << 3) | w;
  function wVarint(v, out) { v = v >>> 0; while (v > 0x7f) { out.push((v & 0x7f) | 0x80); v = Math.floor(v / 128); } out.push(v & 0x7f); }
  function wVarintField(out, f, v) { wVarint(tag(f, 0), out); wVarint(v, out); }
  function wBytesField(out, f, data) { wVarint(tag(f, 2), out); wVarint(data.length, out); for (const b of data) out.push(b); }
  function wFixed32Field(out, f, v) { wVarint(tag(f, 5), out); out.push(v & 0xff, (v >>> 8) & 0xff, (v >>> 16) & 0xff, (v >>> 24) & 0xff); }
  function rVarint(b, pos) { let r = 0, s = 0, x; do { x = b[pos.i++]; r += (x & 0x7f) * Math.pow(2, s); s += 7; } while (x & 0x80); return r; }

  function frame(payload) { const n = payload.length; return new Uint8Array([0x94, 0xc3, (n >> 8) & 0xff, n & 0xff, ...payload]); }
  function encWantConfig() { const p = []; wVarintField(p, 3, NONCE); return frame(p); }

  // MeshPacket.id (fixed32, field 6). Meshtastic's router dedups by (from, id), so every packet
  // MUST carry a unique id — otherwise a burst (e.g. /put data chunks) all share id=0 and every one
  // after the first is dropped as a duplicate. Real clients set this; our hand-rolled one must too.
  let _pid = (Math.floor(Math.random() * 0x7fffffff)) >>> 0;
  function nextPid() { _pid = (_pid + 1) >>> 0; return _pid || 1; }

  function encTextTo(text, toAddr) {
    const data = []; wVarintField(data, 1, 1); wBytesField(data, 2, Array.from(enc.encode(text)));
    const mesh = []; wFixed32Field(mesh, 2, toAddr); wFixed32Field(mesh, 6, nextPid()); wBytesField(mesh, 4, data); wVarintField(mesh, 9, 3);
    const radio = []; wBytesField(radio, 1, mesh);
    return frame(radio);
  }

  function parseMyInfo(b) { const pos = { i: 0 }; let num = 0; while (pos.i < b.length) { const t = rVarint(b, pos), f = t >>> 3, w = t & 7; if (w === 0) { const v = rVarint(b, pos); if (f === 1) num = v; } else if (w === 2) { const l = rVarint(b, pos); pos.i += l; } else if (w === 5) pos.i += 4; else if (w === 1) pos.i += 8; else break; } return num; }
  function parseData(b) { const pos = { i: 0 }; let port = 0, text = null; while (pos.i < b.length) { const t = rVarint(b, pos), f = t >>> 3, w = t & 7; if (w === 0) { const v = rVarint(b, pos); if (f === 1) port = v; } else if (w === 2) { const l = rVarint(b, pos); const s = b.slice(pos.i, pos.i + l); pos.i += l; if (f === 2) text = new TextDecoder().decode(s); } else if (w === 5) pos.i += 4; else if (w === 1) pos.i += 8; else break; } return port === 1 ? text : null; }
  function parsePacketText(b) { const pos = { i: 0 }; let text = null; while (pos.i < b.length) { const t = rVarint(b, pos), f = t >>> 3, w = t & 7; if (w === 0) rVarint(b, pos); else if (w === 5) pos.i += 4; else if (w === 1) pos.i += 8; else if (w === 2) { const l = rVarint(b, pos); const s = b.slice(pos.i, pos.i + l); pos.i += l; if (f === 4) text = parseData(s); } else break; } return text; }
  function parseFromRadio(b) { const pos = { i: 0 }, out = {}; while (pos.i < b.length) { const t = rVarint(b, pos), f = t >>> 3, w = t & 7; if (w === 0) { const v = rVarint(b, pos); if (f === 7) out.complete = v; } else if (w === 2) { const l = rVarint(b, pos); const s = b.slice(pos.i, pos.i + l); pos.i += l; if (f === 3) out.nodeNum = parseMyInfo(s); else if (f === 2) out.text = parsePacketText(s); } else if (w === 5) pos.i += 4; else if (w === 1) pos.i += 8; else break; } return out; }

  // ── state ──
  let port = null, writer = null, reader = null, nodeNum = 0, connected = false;
  let uploader = null;
  const $ = (id) => document.getElementById(id);
  const logEl = $('gm-log');
  function log(msg, cls) { const s = document.createElement('span'); s.className = cls || 'gm-dim'; s.textContent = msg + '\n'; logEl.appendChild(s); logEl.scrollTop = logEl.scrollHeight; }
  function last4() { return (nodeNum & 0xffff).toString(16).padStart(4, '0'); }

  async function send(bytes, echo) { if (writer) { await writer.write(bytes); if (echo) log('> ' + echo, 'gm-tx'); } }

  // Frame sync state machine over the incoming byte stream.
  let st = 0, len = 0, buf = [], gotNode = false, handshakeDone = false;
  function onByte(x) {
    if (st === 0) { if (x === 0x94) st = 1; }
    else if (st === 1) { st = x === 0xc3 ? 2 : 0; }
    else if (st === 2) { len = x << 8; st = 3; }
    else if (st === 3) { len |= x; buf = []; st = len > 0 && len < 512 ? 4 : 0; }
    else if (st === 4) { buf.push(x); if (buf.length >= len) { handleFrame(new Uint8Array(buf)); st = 0; } }
  }
  function handleFrame(payload) {
    const fr = parseFromRadio(payload);
    if (fr.nodeNum && !gotNode) { nodeNum = fr.nodeNum; gotNode = true; log('NODE !' + (nodeNum >>> 0).toString(16).padStart(8, '0') + ' (@' + last4() + ')', 'gm-rx'); }
    if (fr.complete === NONCE && !handshakeDone) { handshakeDone = true; log('HANDSHAKE COMPLETE. Reading config…', 'gm-dim'); requestCfg(); initializeTools(); }
    if (fr.text) onText(fr.text);
  }

  function onText(t) {
    if (t.startsWith('CFG ')) {
      // decimal token: `k=<dec>`; hex token: `k=<hex>`. Anchor on a space/start so gps ⊄ gpsint etc.
      const g = (k) => { const m = t.match(new RegExp('(?:^| )' + k + '=(\\d+)')); return m ? parseInt(m[1], 10) : null; };
      const gh = (k) => { const m = t.match(new RegExp('(?:^| )' + k + '=([0-9a-fA-F]+)')); return m ? parseInt(m[1], 16) : null; };
      applyCfg({ prox: g('prox'), light: g('light'), rep: gh('rep'), out: gh('out'), in: gh('in'),
                 gps: g('gps'), gpsint: g('gpsint'), telint: g('telint') });
      log('< ' + t, 'gm-rx');
      $('gm-panel').style.display = 'block';
    } else if (t.startsWith('PUT ')) {
      if (uploader) uploader.onReply(t); // file-transfer verify/resume replies
      log('< ' + t, 'gm-rx');
    } else if (t.includes('=')) {
      log('< ' + t, 'gm-rx'); // /set echo
    }
  }

  function applyCfg(c) {
    setSlider('gm-prox', c.prox, ' cm');
    setSlider('gm-light', c.light, '');
    setSlider('gm-gpsint', c.gpsint, ' s');
    setSlider('gm-telint', c.telint, ' s');
    setToggle('gm-gps', c.gps);
    applyMask(c.rep, REP_BITS);
    applyMask(c.out, OUT_BITS);
    applyMask(c.in, IN_BITS);
  }
  function applyMask(v, bits) { if (v == null) return; bits.forEach(([k], i) => setToggle('gm-' + k, (v >> i) & 1)); }
  function setSlider(id, val, unit) { if (val == null) return; const el = $(id); if (!el) return; el.value = val; const o = $(id + '-out'); if (o) o.textContent = val + unit; }
  function setToggle(id, on) { const b = $(id); if (!b || on == null) return; b.dataset.on = on ? '1' : '0'; b.textContent = on ? 'ON' : 'OFF'; }

  // Build the .gm-field--row toggle buttons for a section from its bit table (DRY — one row per bit).
  function renderToggles(containerId, bits) {
    const c = $(containerId);
    if (!c) return;
    c.innerHTML = bits.map(([k, label]) =>
      `<div class="gm-field gm-field--row"><label>${label}</label>` +
      `<button class="gm-toggle" id="gm-${k}" data-on="0">OFF</button></div>`).join('');
  }

  async function requestCfg() { await send(encTextTo('/cfg @' + last4(), nodeNum), '/cfg @' + last4()); }
  async function setKey(key, val) { const cmd = '/set @' + last4() + ' ' + key + ' ' + val; await send(encTextTo(cmd, nodeNum), cmd); }

  // The /put payload uploader needs a live connection + node id, so it inits after handshake.
  // (The firmware flasher does NOT — it owns its own port and is mounted on page load; see init().)
  async function initializeTools() {
    try {
      // Payload uploader speaks the /put protocol over the PROTO text channel. sendCmd wraps a
      // text command in a self-addressed frame (no mesh broadcast); PUT replies route via onText.
      if (!uploader && port && nodeNum) {
        log('Initializing payload uploader…', 'gm-dim');
        uploader = putUploaderInit({
          sendCmd: (text) => send(encTextTo(text, nodeNum)), // returns the write promise → callers await
          nodeIdHex: last4(),
          log,
        });
        $('gm-uploader').appendChild(uploader.element);
      }
    } catch (e) {
      log('TOOL INIT FAILED: ' + e.message, 'gm-err');
    }
  }

  async function readLoop() {
    try {
      while (port && port.readable) {
        const { value, done } = await reader.read();
        if (done) break;
        for (const x of value) onByte(x);
      }
    } catch (e) { log('SIGNAL LOST: ' + e.message, 'gm-err'); }
  }

  async function connect() {
    if (!('serial' in navigator)) { $('gm-unsupported').style.display = 'block'; return; }
    try {
      port = await navigator.serial.requestPort();
      await port.open({ baudRate: 115200 });
      writer = port.writable.getWriter();
      reader = port.readable.getReader();
      connected = true; gotNode = false; handshakeDone = false;
      $('gm-status').textContent = 'LINKED'; $('gm-status').classList.add('on');
      $('gm-connect').textContent = '[ LINKED ]';
      log('LINK OPEN @115200. Querying node…', 'gm-dim');
      readLoop();
      await send(encWantConfig(), 'want_config');
      // If the node is mid-stream, retry the handshake a couple of times.
      setTimeout(() => { if (!handshakeDone && connected) send(encWantConfig()); }, 2200);
      setTimeout(() => { if (!handshakeDone && connected) log('NO RESPONSE. Confirm this is the Heltec USB port, running GhostMesh firmware.', 'gm-err'); }, 6000);
    } catch (e) { log('LINK FAILED: ' + e.message, 'gm-err'); }
  }

  function init() {
    if (!('serial' in navigator)) $('gm-unsupported').style.display = 'block';
    $('gm-connect').addEventListener('click', connect);
    $('gm-refresh').addEventListener('click', requestCfg);

    // Build the reply/output/input toggle rows from the bit tables, then wire them.
    renderToggles('gm-rep', REP_BITS);
    renderToggles('gm-out', OUT_BITS);
    renderToggles('gm-in', IN_BITS);

    // Sliders send on change, update the readout live on input.
    const slider = (id, key, unit) => {
      $(id).addEventListener('change', (e) => { const v = e.target.value; $(id + '-out').textContent = v + unit; setKey(key, v); });
      $(id).addEventListener('input', (e) => { $(id + '-out').textContent = e.target.value + unit; });
    };
    slider('gm-prox', 'prox', ' cm');
    slider('gm-light', 'light', '');
    slider('gm-gpsint', 'gpsint', ' s');
    slider('gm-telint', 'telint', ' s');

    // Every toggle: flip data-on and send its /set key. Covers rep/out/in flags + the standalone gps.
    const toggleKeys = [...REP_BITS, ...OUT_BITS, ...IN_BITS, ['gps']].map(([k]) => k);
    for (const key of toggleKeys) {
      const id = 'gm-' + key;
      $(id).addEventListener('click', () => { const on = $(id).dataset.on === '1' ? 0 : 1; setToggle(id, on); setKey(key, on ? 'on' : 'off'); });
    }

    // Masters: fire the macro, then re-query so the individual toggles snap to their new state.
    $('gm-silent').addEventListener('click', async () => { await setKey('silent', 'on'); setTimeout(requestCfg, 300); });
    $('gm-sensors').addEventListener('click', async () => { await setKey('sensors', 'off'); setTimeout(requestCfg, 300); });

    // Firmware flasher is standalone (owns its own port) — mount it now, no connection required.
    $('gm-flasher').appendChild(flasherInit({
      hostedUrl: '/firmware/ghostmesh-heltec-v3.factory.bin',
      hostedLabel: 'GhostMesh Heltec V3 — latest',
      log,
    }));
  }

  // Astro defers module scripts, so DOMContentLoaded may have already fired.
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>

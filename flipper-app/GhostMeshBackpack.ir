Filetype: IR signals file
Version: 1
# GhostMesh backpack remote — arm/disarm over IR (NEC). The backpack's IRModule (GPIO48)
# decodes these; whatever it logs becomes IR_ARM_CODE / IR_DISARM_CODE. Copy to the Flipper
# SD at infrared/GhostMeshBackpack.ir and open in the Infrared app.
#
name: ARM
type: parsed
protocol: NEC
address: BE 00 00 00
command: A1 00 00 00
#
name: DISARM
type: parsed
protocol: NEC
address: BE 00 00 00
command: A2 00 00 00
#

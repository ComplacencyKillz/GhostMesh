Filetype: IR signals file
Version: 1
# GhostMesh backpack remote — NECext, address 0x474D ('GM'). The backpack's IRModule (GPIO48)
# decodes address + command; it acts only on address 0x474D. Copy to the Flipper SD at
# infrared/GhostMeshBackpack.ir and open in the Infrared app (until the FAP transmits these itself).
#
# Commands: 01 ARM · 02 DISARM · 03 WIPE · 04 CONFIRM.
# WIPE is an out-of-band destruct: send ARM, then WIPE, then CONFIRM (within 10 s), while armed.
#
name: ARM
type: parsed
protocol: NECext
address: 4D 47 00 00
command: 01 00 00 00
#
name: DISARM
type: parsed
protocol: NECext
address: 4D 47 00 00
command: 02 00 00 00
#
name: WIPE
type: parsed
protocol: NECext
address: 4D 47 00 00
command: 03 00 00 00
#
name: CONFIRM
type: parsed
protocol: NECext
address: 4D 47 00 00
command: 04 00 00 00
#

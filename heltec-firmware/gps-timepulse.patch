@@ -1884,4 +1884,18 @@ void GPS::toggleGpsMode()
         enable();
     }
 }
+
+// GhostMesh vendor patch: silence the u-blox timepulse (CFG-TP5), which drives the BN-220's PPS/fix
+// LED, for stealth mode. Best-effort: on=false sends the disable; on=true is a no-op because reliably
+// re-enabling PPS needs a GPS reset. RAM-only on the module (reverts on GPS power-cycle).
+void GPS::setTimepulseEnabled(bool on)
+{
+    if (!_serial_gps)
+        return; // no serial GPS on this build
+    if (on)
+        return; // leave the module default (LED on); we only actively silence it
+    uint8_t msglen = makeUBXPacket(0x06, 0x31, sizeof(_message_GM_CFG_TP5_DISABLE), _message_GM_CFG_TP5_DISABLE);
+    _serial_gps->write(UBXscratch, msglen);
+    LOG_INFO("GhostMesh: GPS timepulse disabled (CFG-TP5) to silence the PPS LED");
+}
 #endif // Exclude GPS

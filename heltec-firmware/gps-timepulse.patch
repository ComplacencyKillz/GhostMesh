+// ── GhostMesh vendor patch ────────────────────────────────────────────────────────────
+// CFG-TP5 (class 0x06, id 0x31) timepulse DISABLE: 32-byte payload, all zero → flags.active=0, so
+// the u-blox stops driving its PPS/timepulse output and the BN-220's onboard PPS/fix LED goes dark.
+// Best-effort silent-mode helper (RAM-only; reverts if the GPS is power-cycled). Sent by
+// GPS::setTimepulseEnabled(false). NOT part of the ghostmesh repo — re-apply on a fresh checkout
+// (see heltec-firmware/README.md). tpIdx=0, version=1, everything else 0.
+static const uint8_t _message_GM_CFG_TP5_DISABLE[] PROGMEM = {
+    0x00, 0x01, 0x00, 0x00, // tpIdx=0, version=1, reserved1
+    0x00, 0x00, 0x00, 0x00, // antCableDelay, rfGroupDelay
+    0x00, 0x00, 0x00, 0x00, // freqPeriod
+    0x00, 0x00, 0x00, 0x00, // freqPeriodLock
+    0x00, 0x00, 0x00, 0x00, // pulseLenRatio
+    0x00, 0x00, 0x00, 0x00, // pulseLenRatioLock
+    0x00, 0x00, 0x00, 0x00, // userConfigDelay
+    0x00, 0x00, 0x00, 0x00, // flags (bit0 active = 0 → timepulse off)
+};
+
